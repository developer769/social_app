# Copy to .env.production on the server and fill in. Never commit the real one.
#
# Generate the four secrets with:
#   openssl rand -hex 64   # SECRET_KEY_BASE
#   openssl rand -hex 16   # each AR_ENCRYPTION_* value

SECRET_KEY_BASE=
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=

# The 32 characters in config/master.key on the development machine. Without
# it the app cannot decrypt credentials.
RAILS_MASTER_KEY=

POSTGRES_PASSWORD=

APP_HOST=prachar.dcrayons.app
APP_HOSTS=prachar.dcrayons.app

# Real mail. Password resets and email confirmations are live features: a
# reset link that is generated but never delivered is worse than not offering
# one at all.
MAIL_FROM=Prachar <no-reply@dcrayons.app>
MAIL_REPLY_TO=support@dcrayons.app
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- Social platform API credentials --------------------------------------
# Empty until each platform's app review is approved. A provider with no
# credentials simply cannot be connected: the UI says so and the OAuth flow
# refuses to start, rather than failing halfway through.
#
# Register this exact redirect URI with every platform:
#   https://APP_HOST/auth/PROVIDER/callback
#
# One Meta app serves both Instagram and Facebook; one Google app serves both
# YouTube and Google Business Profile.
META_CLIENT_ID=
META_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
