<% content_for :title, "Join #{@membership.workspace.name}" %>

<div class="mx-auto flex min-h-dvh max-w-md flex-col justify-center px-6 py-16">
  <%= render "shared/wordmark", classes: "text-2xl" %>

  <div class="mt-8 rounded-card border border-border bg-surface p-8 shadow-card">
    <span aria-hidden="true"
          class="mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-blue-soft text-primary">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-6 w-6">
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3.5 6.5 8.5 6 8.5-6" stroke-linecap="round" />
      </svg>
    </span>

    <h1 class="font-display text-2xl font-normal">
      <%= @membership.invited_by&.name || "Someone" %> invited you to
      <%= @membership.workspace.name %>
    </h1>
    <p class="mt-2 text-sm text-body">
      Prachar helps businesses plan, create and schedule their social media.
      Accepting gives you the same access as everyone else in this workspace.
    </p>

    <% if signed_in? %>
      <p class="mt-5 rounded-control border border-border bg-background px-4 py-3 text-sm text-body">
        You are signed in as <span class="font-medium text-heading"><%= current_user.email %></span>.
        Accepting joins this account to the workspace.
      </p>

      <%= button_to "Accept and join", accept_invitation_path(token: params[:token]),
            class: "mt-5 h-11 w-full cursor-pointer rounded-control bg-primary px-5 text-sm font-medium text-primary-contrast hover:bg-primary-hover" %>
    <% else %>
      <%= render "shared/error_summary", record: @user %>

      <%# The address is fixed to the one invited, so an invitation cannot be
          redirected to a different account by editing a form field. %>
      <p class="mt-5 rounded-control border border-border bg-background px-4 py-3 text-sm text-body">
        Creating an account for
        <span class="font-medium text-heading"><%= @membership.invitation_email %></span>
      </p>

      <%= form_with model: @user, url: accept_invitation_path(token: params[:token]),
                    scope: :user, class: "mt-5 space-y-4" do |form| %>
        <%= render FormFieldComponent.new(form: form, attribute: :name, label: "Your name",
              required: true, autocomplete: "name") %>

        <%= render FormFieldComponent.new(form: form, attribute: :password, label: "Choose a password",
              type: :password_field, required: true, autocomplete: "new-password",
              hint: "At least 12 characters", minlength: 12) %>

        <%= form.submit "Accept and create my account",
              class: "h-11 w-full cursor-pointer rounded-control bg-primary px-5 text-sm font-medium text-primary-contrast hover:bg-primary-hover" %>
      <% end %>
    <% end %>

    <%= button_to "No thanks, decline", decline_invitation_path(token: params[:token]),
          method: :delete,
          form: { data: { turbo_confirm: "Decline this invitation?" } },
          class: "mt-3 w-full cursor-pointer rounded-control px-5 py-2 text-sm text-muted hover:text-heading" %>
  </div>

  <% if @membership.expires_at %>
    <p class="mt-5 text-center text-xs text-muted">
      This invitation expires on <%= l(@membership.expires_at.to_date, format: :long) %>.
    </p>
  <% end %>
</div>
