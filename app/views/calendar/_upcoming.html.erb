<section class="rounded-card border border-border bg-surface p-5">
  <h2 class="font-display text-lg font-normal">Upcoming posts</h2>

  <% if posts.empty? %>
    <p class="mt-3 text-sm text-muted">
      Nothing scheduled yet. Anything you schedule appears here with a countdown.
    </p>
  <% else %>
    <ul class="mt-4 space-y-3">
      <% posts.each do |post| %>
        <li class="flex items-start gap-3">
          <% if post.primary_media&.file&.attached? %>
            <%= image_tag post.primary_media.file.variant(resize_to_fill: [80, 80]), alt: "",
                  class: "h-10 w-10 shrink-0 rounded-control object-cover" %>
          <% else %>
            <span aria-hidden="true" class="h-10 w-10 shrink-0 rounded-control bg-surface-sunk"></span>
          <% end %>

          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-medium text-heading">
              <%= post.caption.presence&.truncate(38) || "Untitled post" %>
            </p>
            <p class="mt-0.5 text-xs text-muted">
              <%= post.scheduled_at_local&.strftime("%-d %b, %-l:%M %p") %>
            </p>
          </div>

          <span class="shrink-0 rounded-pill bg-gold-tint px-2 py-1 text-[11px] font-medium text-heading">
            <%= relative_schedule(post, current_workspace) %>
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
