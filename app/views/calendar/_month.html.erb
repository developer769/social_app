<div class="overflow-hidden rounded-card border border-border bg-surface">
  <table class="w-full table-fixed border-collapse">
    <caption class="sr-only">
      Scheduled posts for <%= calendar.period.title(calendar.zone) %>
    </caption>

    <thead>
      <tr>
        <% %w[Sun Mon Tue Wed Thu Fri Sat].each do |day| %>
          <th scope="col"
              class="border-b border-border py-3 text-center text-xs font-medium uppercase tracking-wide text-muted">
            <%= day %>
          </th>
        <% end %>
      </tr>
    </thead>

    <tbody>
      <% calendar.days.each_slice(7) do |week| %>
        <tr>
          <% week.each do |day| %>
            <%
              in_month = day.month == calendar.anchor.month
              today = day == calendar.zone.today
              posts = calendar.posts_by_date[day] || []
            %>
            <td class="h-36 border-b border-r border-border align-top last:border-r-0 <%= "bg-background/60" unless in_month %>">
              <div class="flex h-full flex-col gap-1 p-1.5">
                <span class="<%= class_names(
                      "flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-xs tabular-nums",
                      "bg-primary font-semibold text-primary-contrast" => today,
                      "text-muted/70" => !today && !in_month,
                      "text-body" => !today && in_month) %>">
                  <%= day.day %>
                </span>

                <ul class="flex min-h-0 flex-1 flex-col gap-1 overflow-hidden">
                  <% posts.first(1).each do |post| %>
                    <li><%= render "calendar/event", post: post, compact: true %></li>
                  <% end %>

                  <% if posts.size > 1 %>
                    <li>
                      <%= link_to workspace_calendar_path(workspace_slug: current_workspace.slug,
                                                          view: "day", date: day.to_s),
                            class: "block rounded-[0.3rem] px-1.5 py-1 text-[10px] font-medium text-primary hover:bg-surface-sunk" do %>
                        + <%= posts.size - 1 %> more
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </div>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
