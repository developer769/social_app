<% content_for :title, @template.name %>
<% slug = { workspace_slug: current_workspace.slug } %>

<nav aria-label="Breadcrumb" class="mb-5 flex flex-wrap items-center gap-2 text-sm text-muted">
  <%= link_to "Gallery", workspace_gallery_path(**slug), class: "hover:text-heading" %>
  <span aria-hidden="true">&rsaquo;</span>
  <%= link_to (@template.format_video? ? "Video styles" : "Photo styles"),
        workspace_gallery_path(**slug, format: @template.media_format), class: "hover:text-heading" %>
  <span aria-hidden="true">&rsaquo;</span>
  <span class="text-heading"><%= @template.name %></span>
</nav>

<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
  <div class="min-w-0">
    <div class="overflow-hidden rounded-card border border-border bg-surface">
      <div class="<%= @template.format_video? ? 'aspect-9/16 max-h-[70vh]' : 'aspect-4/3' %> bg-surface-sunk">
        <% if @template.preview.attached? %>
          <%= image_tag @template.preview.variant(resize_to_limit: [1200, 1200]),
                alt: @template.name, class: "h-full w-full object-contain" %>
        <% else %>
          <span class="flex h-full items-center justify-center text-sm text-muted">No preview</span>
        <% end %>
      </div>

      <%#
        The design shows like, comment and save counts here. Those would be
        engagement on a post, which a style does not have. What Prachar can
        honestly count is how many businesses have used the style, and below a
        useful threshold it says so rather than showing a bare zero (spec 27).
      %>
      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-border px-5 py-3.5">
        <p class="text-sm text-muted"><%= template_usage_note(@template) %></p>
        <p class="text-xs text-muted">
          Added <%= l(@template.first_seen_at.to_date, format: :long) %>
        </p>
      </div>
    </div>
  </div>

  <aside class="space-y-5">
    <section class="rounded-card border border-border bg-surface p-6">
      <p class="mb-3 inline-flex items-center gap-1.5 rounded-pill bg-gold-tint px-3 py-1 text-xs font-medium text-heading">
        <span aria-hidden="true" class="text-accent">&#10022;</span>
        Style preview
      </p>

      <h1 class="font-display text-2xl font-normal"><%= @template.name %></h1>

      <div class="mt-3 flex flex-wrap gap-1.5">
        <span class="rounded-control border border-border px-2.5 py-1 text-xs text-body">
          <%= @template.format_video? ? "Video" : "Photo" %>
        </span>
        <% if @template.duration_label %>
          <span class="rounded-control border border-border px-2.5 py-1 text-xs text-body tabular-nums">
            <%= @template.duration_label %>
          </span>
        <% end %>
        <% if @template.premium? %>
          <span class="rounded-control bg-gold-soft px-2.5 py-1 text-xs font-medium text-heading">Premium</span>
        <% end %>
      </div>

      <% if @template.description.present? %>
        <p class="mt-4 text-sm text-body"><%= @template.description %></p>
      <% end %>

      <%= button_to workspace_gallery_template_use_path(**slug, slug: @template.slug),
            class: "mt-5 h-11 w-full cursor-pointer rounded-control bg-primary px-5 text-sm font-medium text-primary-contrast hover:bg-primary-hover" do %>
        Use this style
      <% end %>

      <p class="mt-2 text-center text-xs text-muted">
        Starts a post you can add your own picture to.
      </p>

      <dl class="mt-6 space-y-2.5 border-t border-border pt-5 text-sm">
        <div class="flex justify-between gap-3">
          <dt class="text-muted">Category</dt>
          <dd class="text-heading"><%= @template.category_label %></dd>
        </div>
        <div class="flex justify-between gap-3">
          <dt class="text-muted">Shape</dt>
          <dd class="text-heading"><%= @template.aspect_ratio %></dd>
        </div>
        <% if @template.style_tags.any? %>
          <div class="flex justify-between gap-3">
            <dt class="shrink-0 text-muted">Style</dt>
            <dd class="text-right text-heading"><%= @template.style_tags.map(&:humanize).to_sentence %></dd>
          </div>
        <% end %>
      </dl>
    </section>

    <%#
      Where this style can actually go, computed from the workspace's own
      connected accounts and each provider's real capabilities, so it never
      promises a destination the API would refuse (spec 30).
    %>
    <section class="rounded-card border border-border bg-blue-soft p-6">
      <h2 class="font-display text-lg font-normal">Where this can go</h2>

      <% if current_workspace.social_accounts.connected.empty? %>
        <p class="mt-2 text-sm text-body">
          No accounts connected yet. This style suits
          <%= @template.compatible_providers.map { |key| SocialProvider::Catalog.find(key)&.name }.compact.to_sentence %>.
        </p>
        <%= link_to "Connect an account",
              workspace_onboarding_connections_path(**slug),
              class: "mt-4 inline-flex h-10 items-center rounded-control bg-primary px-4 text-sm font-medium text-primary-contrast hover:bg-primary-hover" %>
      <% else %>
        <ul class="mt-3 space-y-2">
          <% @compatible.each do |account| %>
            <li class="flex items-center gap-2.5 text-sm text-heading">
              <%= render PlatformGlyphComponent.new(provider: account.provider, size: :small) %>
              <%= account.provider_name %>
            </li>
          <% end %>

          <% @incompatible.each do |account| %>
            <li class="flex items-start gap-2.5 text-sm text-muted">
              <span aria-hidden="true" class="mt-0.5">&#10007;</span>
              <span>
                <%= account.provider_name %> &mdash;
                <%= @template.format_video? ? "cannot post video" : "only accepts video" %>
              </span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </aside>
</div>
