<% content_for :title, "Social accounts" %>

<%= render "settings/page_header",
      title: "Social accounts",
      subtitle: "Connect and manage the accounts Prachar publishes to." %>

<%= render "shared/flash" %>

<% if SocialProvider::Registry.any_real? == false %>
  <div role="note" class="mb-6 flex gap-3 rounded-card border border-border bg-blue-soft px-5 py-4">
    <span aria-hidden="true" class="text-primary">&#9432;</span>
    <p class="text-sm text-body">
      <span class="font-medium text-heading">These connections are simulated.</span>
      Real accounts need each platform's API credentials and app review. Nothing here
      publishes to a real profile.
    </p>
  </div>
<% end %>

<ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
  <% @providers.each do |provider| %>
    <li>
      <%= render "onboarding/connections/provider_card",
            provider: provider, account: @accounts_by_provider[provider.key] %>
    </li>
  <% end %>
</ul>
