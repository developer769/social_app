<% content_for :title, "Settings" %>
<% tones = { gold: "bg-gold-tint", blue: "bg-blue-soft", lavender: "bg-lavender-soft" } %>

<header class="mb-7">
  <h1 class="font-display text-3xl font-normal sm:text-4xl">Settings</h1>
  <p class="mt-1.5 text-sm text-muted">Manage your workspace, preferences, integrations and catalog.</p>
</header>

<%= render "shared/flash" %>

<ul class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
  <% @entries.each do |entry| %>
    <li>
      <% path = SettingsMenu.path_for(entry, current_workspace) %>

      <% if path %>
        <%= link_to path,
              class: "flex h-full items-start gap-4 rounded-card border border-border #{tones.fetch(entry.tone, 'bg-surface')} p-5 transition-shadow hover:shadow-card" do %>
          <span class="min-w-0 flex-1">
            <span class="block font-display text-lg text-heading"><%= entry.title %></span>
            <span class="mt-1 block text-sm text-body"><%= entry.summary %></span>
          </span>
          <span aria-hidden="true" class="mt-1 text-muted">&rsaquo;</span>
        <% end %>
      <% else %>
        <%# Not built. Says what it is waiting on, rather than being a card that
            does nothing when clicked. %>
        <div class="flex h-full items-start gap-4 rounded-card border border-dashed border-border bg-surface p-5">
          <span class="min-w-0 flex-1">
            <span class="flex items-center gap-2">
              <span class="font-display text-lg text-muted"><%= entry.title %></span>
              <span class="rounded-pill border border-border px-1.5 py-0.5 text-[10px] font-medium text-muted">Soon</span>
            </span>
            <span class="mt-1 block text-sm text-muted"><%= entry.summary %></span>
            <span class="mt-2 block text-xs text-muted"><%= entry.waiting_on %></span>
          </span>
        </div>
      <% end %>
    </li>
  <% end %>
</ul>
