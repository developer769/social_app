<% content_for :title, "Team" %>

<%= render "settings/page_header",
      title: "Team",
      subtitle: "Invite people to help run #{current_workspace.name}." %>

<%= render "shared/flash" %>

<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
  <div class="min-w-0 space-y-6">
    <section class="rounded-card border border-border bg-surface p-6">
      <h2 class="font-display text-xl font-normal">Invite someone</h2>
      <p class="mt-1 text-sm text-muted">
        They will get an email with a link. Nothing happens until they accept it.
      </p>

      <%= form_with url: workspace_settings_team_index_path(workspace_slug: current_workspace.slug),
                    method: :post, class: "mt-4 flex flex-wrap items-end gap-3" do |form| %>
        <div class="min-w-56 flex-1">
          <%= form.label :email, "Email address", class: "mb-1.5 block text-sm font-medium text-heading" %>
          <%= form.email_field :email, required: true, placeholder: "teammate@example.com",
                class: "h-11 w-full rounded-control border border-border bg-background px-3.5 text-sm text-heading placeholder:text-muted focus:border-border-strong focus:outline-none" %>
        </div>
        <%= form.submit "Send invitation",
              class: "h-11 cursor-pointer rounded-control bg-primary px-5 text-sm font-medium text-primary-contrast hover:bg-primary-hover" %>
      <% end %>

      <%#
        No role selector, deliberately. Roles are undefined in the specification,
        so everyone who accepts gets the same access, and saying so is better
        than a dropdown implying a choice that does not exist.
      %>
      <p class="mt-4 flex gap-2.5 rounded-control border border-border bg-blue-soft px-4 py-3 text-sm text-body">
        <span aria-hidden="true" class="text-primary">&#9432;</span>
        <span>
          Everyone you invite gets the same access to this workspace.
          Different permission levels are not available yet.
        </span>
      </p>
    </section>

    <section class="rounded-card border border-border bg-surface p-6">
      <h2 class="font-display text-xl font-normal">
        In this workspace <span class="text-base text-muted">(<%= @members.size %>)</span>
      </h2>

      <ul class="mt-4 divide-y divide-border">
        <% @members.each do |membership| %>
          <li class="flex flex-wrap items-center gap-3 py-3.5">
            <span aria-hidden="true"
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue-soft text-xs font-semibold text-primary">
              <%= membership.user.name.split.first(2).map { |word| word[0] }.join.upcase %>
            </span>

            <div class="min-w-0 flex-1">
              <p class="flex flex-wrap items-center gap-2 text-sm font-medium text-heading">
                <%= membership.user.name %>
                <% if current_workspace.owned_by?(membership.user) %>
                  <%= render StatusBadgeComponent.new(label: "Owner", tone: :highlight) %>
                <% end %>
                <% if membership.user_id == current_user.id %>
                  <span class="text-xs font-normal text-muted">(you)</span>
                <% end %>
              </p>
              <p class="mt-0.5 truncate text-xs text-muted"><%= membership.user.email %></p>
            </div>

            <p class="text-xs text-muted">
              Joined <%= l(membership.accepted_at.to_date, format: :long) if membership.accepted_at %>
            </p>

            <% unless current_workspace.owned_by?(membership.user) %>
              <%= button_to "Remove",
                    workspace_settings_team_path(workspace_slug: current_workspace.slug, id: membership),
                    method: :delete,
                    form: { data: { turbo_confirm: "Remove #{membership.user.name}? They lose access immediately and are signed out." } },
                    class: "cursor-pointer rounded-control border border-border px-3 py-1.5 text-xs font-medium text-danger hover:bg-danger-soft" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>

    <section class="rounded-card border border-border bg-surface p-6">
      <h2 class="font-display text-xl font-normal">
        Waiting to accept <span class="text-base text-muted">(<%= @pending.size %>)</span>
      </h2>

      <% if @pending.empty? %>
        <p class="mt-3 text-sm text-muted">No invitations are outstanding.</p>
      <% else %>
        <ul class="mt-4 divide-y divide-border">
          <% @pending.each do |membership| %>
            <li class="flex flex-wrap items-center gap-3 py-3.5">
              <span aria-hidden="true"
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gold-tint text-warning">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-5 w-5">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m3.5 6.5 8.5 6 8.5-6" stroke-linecap="round" />
                </svg>
              </span>

              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-medium text-heading"><%= membership.invitation_email %></p>
                <p class="mt-0.5 text-xs text-muted">
                  Invited <%= time_ago_in_words(membership.invited_at) %> ago<%= " by #{membership.invited_by.name}" if membership.invited_by %>
                  <% if membership.expires_at %>
                    &middot; <%= membership.invitation_expired? ? "expired" : "expires #{l(membership.expires_at.to_date, format: :long)}" %>
                  <% end %>
                </p>
              </div>

              <%= button_to "Resend",
                    resend_workspace_settings_team_path(workspace_slug: current_workspace.slug, id: membership),
                    class: "cursor-pointer rounded-control border border-border px-3 py-1.5 text-xs font-medium text-body hover:bg-surface-sunk" %>

              <%= button_to "Cancel",
                    workspace_settings_team_path(workspace_slug: current_workspace.slug, id: membership),
                    method: :delete,
                    form: { data: { turbo_confirm: "Cancel the invitation to #{membership.invitation_email}?" } },
                    class: "cursor-pointer rounded-control border border-border px-3 py-1.5 text-xs font-medium text-danger hover:bg-danger-soft" %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </div>

  <aside class="space-y-5">
    <section class="rounded-card border border-border bg-gold-tint p-5">
      <h2 class="font-display text-lg font-normal">Seats</h2>

      <% if @seat_limit.nil? %>
        <p class="mt-2 text-sm text-body">
          Your plan includes unlimited team members.
          <span class="font-medium text-heading"><%= @seats_used %> used.</span>
        </p>
      <% else %>
        <p class="mt-2 text-2xl font-display text-heading tabular-nums">
          <%= @seats_used %> <span class="text-base text-muted">of <%= @seat_limit %></span>
        </p>
        <div class="mt-3 h-1.5 overflow-hidden rounded-pill bg-border">
          <div class="h-full rounded-pill bg-primary"
               style="width: <%= [(@seats_used.to_f / @seat_limit * 100).round, 100].min %>%"></div>
        </div>
        <% if @seats_used >= @seat_limit %>
          <p class="mt-3 text-sm text-body">
            You have used every seat. Upgrade to invite more people.
          </p>
          <%= link_to "See plans", workspace_settings_billing_path(workspace_slug: current_workspace.slug),
                class: "mt-3 inline-flex h-10 items-center rounded-control bg-primary px-4 text-sm font-medium text-primary-contrast hover:bg-primary-hover" %>
        <% end %>
      <% end %>
    </section>

    <section class="rounded-card border border-border bg-surface p-5">
      <h2 class="font-display text-lg font-normal">What a teammate can do</h2>
      <ul class="mt-3 space-y-2 text-sm text-body">
        <li class="flex gap-2"><span aria-hidden="true" class="text-success">&#10003;</span> Everything you can, in this workspace</li>
        <li class="flex gap-2"><span aria-hidden="true" class="text-muted">&#10007;</span> Reach any of your other workspaces</li>
        <li class="flex gap-2"><span aria-hidden="true" class="text-muted">&#10007;</span> Remove the workspace owner</li>
      </ul>
    </section>
  </aside>
</div>
