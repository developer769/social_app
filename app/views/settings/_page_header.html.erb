<header class="mb-7">
  <%= link_to "← All settings", workspace_settings_root_path(workspace_slug: current_workspace.slug),
        class: "text-sm text-muted underline underline-offset-4 hover:text-heading" %>
  <h1 class="mt-3 font-display text-3xl font-normal sm:text-4xl"><%= title %></h1>
  <% if local_assigns[:subtitle].present? %>
    <p class="mt-1.5 max-w-prose text-sm text-muted"><%= subtitle %></p>
  <% end %>
</header>
