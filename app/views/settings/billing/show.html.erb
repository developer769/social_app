<% content_for :title, "Plan & billing" %>

<%= render "settings/page_header",
      title: "Plan & billing",
      subtitle: "Your plan, what it includes and how much you have used." %>

<%= render "shared/flash" %>

<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
  <div class="min-w-0 space-y-6">
    <% if @subscription %>
      <section class="rounded-card border border-border bg-surface p-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-primary">Current plan</p>
            <h2 class="mt-1 font-display text-3xl font-normal"><%= @subscription.plan.name %></h2>
            <p class="mt-1 text-sm text-muted">
              <%= MoneyPresenter.new(@subscription.plan.price).full %> per <%= @subscription.plan.interval %>
            </p>
          </div>

          <%= render StatusBadgeComponent.new(
                label: @subscription.trialing_now? ? "Trial" : @subscription.status.humanize,
                tone: @subscription.trialing_now? ? :info : :success) %>
        </div>

        <% if @subscription.trialing_now? %>
          <p class="mt-4 rounded-control border border-border bg-gold-tint px-4 py-3 text-sm text-body">
            <span class="font-medium text-heading">
              <%= pluralize(@subscription.trial_days_remaining, "day") %> left in your trial.
            </span>
            Nothing has been charged, and no payment method is stored.
          </p>
        <% end %>

        <h3 class="mt-6 text-xs font-semibold uppercase tracking-wide text-primary">What this plan includes</h3>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2">
          <% @subscription.plan.plan_entitlements.sort_by(&:id).each do |entitlement| %>
            <% live = FeatureAvailability.live?(entitlement.key) %>
            <li class="flex items-start gap-2 text-sm <%= live ? "text-body" : "text-muted" %>">
              <span aria-hidden="true" class="<%= live ? "text-success" : "text-muted" %>">
                <%= live ? "✓" : "○" %>
              </span>
              <span>
                <%= entitlement.display_label %>
                <% unless live %>
                  <span class="block text-xs">Not available yet</span>
                <% end %>
              </span>
            </li>
          <% end %>
        </ul>
      </section>

      <section class="rounded-card border border-border bg-surface p-6">
        <h2 class="font-display text-xl font-normal">Usage</h2>
        <p class="mt-1 text-sm text-muted">Counted from your own records, not estimated.</p>

        <ul class="mt-5 space-y-4">
          <% @usage.each do |line| %>
            <li>
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <p class="text-sm font-medium text-heading"><%= line.label %></p>
                <p class="text-sm tabular-nums <%= line.exhausted? ? "text-danger" : "text-muted" %>">
                  <% if !line.available? %>
                    Not available yet
                  <% elsif line.unlimited? %>
                    <%= number_with_delimiter(line.used) %> &middot; unlimited
                  <% else %>
                    <%= number_with_delimiter(line.used) %> of <%= number_with_delimiter(line.limit) %>
                  <% end %>
                </p>
              </div>

              <% if line.available? && !line.unlimited? %>
                <div class="mt-2 h-1.5 overflow-hidden rounded-pill bg-border">
                  <div class="h-full rounded-pill <%= line.exhausted? ? "bg-danger" : "bg-primary" %>"
                       style="width: <%= line.percentage %>%"></div>
                </div>
              <% end %>

              <% if line.note.present? %>
                <p class="mt-1.5 text-xs text-muted"><%= line.note %></p>
              <% end %>
            </li>
          <% end %>
        </ul>
      </section>
    <% else %>
      <%= render EmptyStateComponent.new(
            title: "No plan chosen yet",
            body: "Pick a plan to see what it includes and how much you have used.") do |state| %>
        <% state.with_action do %>
          <%= link_to "Choose a plan", workspace_onboarding_plan_path(workspace_slug: current_workspace.slug),
                class: "inline-flex h-11 items-center rounded-control bg-primary px-5 text-sm font-medium text-primary-contrast hover:bg-primary-hover" %>
        <% end %>
      <% end %>
    <% end %>
  </div>

  <aside class="space-y-5">
    <section class="rounded-card border border-border bg-blue-soft p-5">
      <h2 class="font-display text-lg font-normal">Payments</h2>
      <p class="mt-2 text-sm text-body">
        <span class="font-medium text-heading">No payment method is stored.</span>
        Payments are not connected yet, so nothing can be charged. You will be asked
        before any money moves.
      </p>
    </section>

    <section class="rounded-card border border-border bg-surface p-5">
      <h2 class="font-display text-lg font-normal">Change plan</h2>
      <p class="mt-2 text-sm text-body">Move up or down at any time.</p>
      <%= link_to "See all plans", workspace_onboarding_plan_path(workspace_slug: current_workspace.slug),
            class: "mt-4 inline-flex h-10 items-center rounded-control border border-border px-4 text-sm font-medium text-body hover:bg-surface-sunk" %>
    </section>
  </aside>
</div>
