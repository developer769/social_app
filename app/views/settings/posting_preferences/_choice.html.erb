<div class="flex flex-wrap items-start justify-between gap-4">
  <div class="min-w-48 flex-1">
    <p class="text-sm font-medium text-heading"><%= title %></p>
    <p class="mt-0.5 text-xs text-muted"><%= summary %></p>
  </div>

  <div class="w-full sm:w-64">
    <%= form.label attribute, title, class: "sr-only" %>
    <%= form.text_field attribute, placeholder: "Warm, friendly and trustworthy",
          class: "h-11 w-full rounded-control border border-border bg-background px-3.5 text-sm text-heading placeholder:text-muted focus:border-border-strong focus:outline-none" %>
  </div>
</div>
