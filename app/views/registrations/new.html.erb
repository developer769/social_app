<% content_for :title, "Create your Prachar account" %>

<%# Matches the sign-in screen: frosted card on the gradient, underline-only
    fields, dark art panel beside it. %>
<div class="auth-orchid" data-controller="brand-scene">
  <div class="orchid-layout">

    <div class="auth-enter orchid-card">
      <div class="mb-7 text-center">
        <%= render "shared/wordmark", classes: "text-lg" %>
        <h1 class="orchid-title mt-4">Sign Up</h1>
      </div>

      <%= render "shared/flash" %>
      <%= render "shared/error_summary", record: @user %>

      <%= form_with model: @user, url: signup_path, method: :post, scope: :user, class: "space-y-6" do |form| %>
        <div class="orchid-row">
          <%# Visually hidden rather than absent: a placeholder disappears the
              moment somebody types, leaving a filled form with no way to tell
              what each line was for. %>
          <%= form.label :business_name, "Business name", class: "sr-only" %>
          <%= form.text_field :business_name, value: params.dig(:user, :business_name), required: true,
                autofocus: true, placeholder: "Business name", class: "orchid-field" %>
          <%= render "shared/orchid_icons", icon: :user %>
        </div>

        <div class="orchid-row">
          <%= form.label :name, "Your name", class: "sr-only" %>
          <%= form.text_field :name, required: true, autocomplete: "name",
                placeholder: "Your name", class: "orchid-field" %>
          <%= render "shared/orchid_icons", icon: :user %>
        </div>

        <div class="orchid-row">
          <%= form.label :email, "Email address", class: "sr-only" %>
          <%= form.email_field :email, required: true, autocomplete: "email",
                placeholder: "Email", class: "orchid-field" %>
          <%= render "shared/orchid_icons", icon: :mail %>
        </div>

        <div class="orchid-row">
          <%= form.label :password, "Password", class: "sr-only" %>
          <%= form.password_field :password, required: true, minlength: 12, autocomplete: "new-password",
                aria: { describedby: "password-hint" },
                placeholder: "Password", class: "orchid-field" %>
          <%= render "shared/orchid_icons", icon: :lock %>
          <p id="password-hint" class="orchid-hint mt-1.5 text-xs">
            At least 12 characters.
          </p>
        </div>

        <div class="pt-1">
          <%= form.submit "Sign Up", class: "orchid-button" %>
        </div>
      <% end %>

      <p class="mt-7 text-right text-sm">
        <%= link_to "Already have an account?", login_path, class: "orchid-link" %>
      </p>
    </div>

    <div class="orchid-art" aria-hidden="true">
      <canvas data-brand-scene-target="canvas"></canvas>
    </div>

  </div>
</div>
