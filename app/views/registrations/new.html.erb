<% content_for :title, "Create your Prachar account" %>

<%# Centred, matching the sign-in screen: one column on a full-width dark
    ground with the scene running behind it. %>
<div class="auth-stage" data-controller="brand-scene">
  <canvas data-brand-scene-target="canvas" aria-hidden="true" class="auth-stage-canvas"></canvas>

  <div class="auth-stage-content">
    <div class="mb-7 text-center">
      <%= render "shared/wordmark", classes: "text-3xl", tone: :light %>
    </div>

    <div class="w-full">
      <div class="auth-enter rounded-card border border-border bg-surface p-8 shadow-card sm:p-10">
        <div class="mb-8 text-center">
          <h1 class="font-display text-3xl font-normal">Create your account</h1>
          <p class="mt-2 text-sm text-muted">Set up your business workspace in under a minute.</p>
        </div>

        <%= render "shared/flash" %>
        <%= render "shared/error_summary", record: @user %>

        <%= form_with model: @user, url: signup_path, method: :post, scope: :user, class: "space-y-5" do |form| %>
          <div>
            <%= form.label :business_name, "Business name", class: "mb-1.5 block text-sm font-medium text-heading" %>
            <%= form.text_field :business_name, value: params.dig(:user, :business_name), required: true,
                  autofocus: true, placeholder: "Anaya Bakes",
                  class: "h-11 w-full rounded-control border border-border bg-background px-3.5 text-sm text-heading placeholder:text-muted focus:border-border-strong focus:outline-none" %>
            <p class="mt-1.5 text-xs text-muted">This becomes your workspace. You can rename it later.</p>
          </div>

          <div>
            <%= form.label :name, "Your name", class: "mb-1.5 block text-sm font-medium text-heading" %>
            <%= form.text_field :name, required: true, autocomplete: "name",
                  class: "h-11 w-full rounded-control border border-border bg-background px-3.5 text-sm text-heading focus:border-border-strong focus:outline-none" %>
          </div>

          <div>
            <%= form.label :email, "Email address", class: "mb-1.5 block text-sm font-medium text-heading" %>
            <%= form.email_field :email, required: true, autocomplete: "email",
                  class: "h-11 w-full rounded-control border border-border bg-background px-3.5 text-sm text-heading focus:border-border-strong focus:outline-none" %>
          </div>

          <div>
            <%= form.label :password, "Password", class: "mb-1.5 block text-sm font-medium text-heading" %>
            <%= form.password_field :password, required: true, minlength: 12, autocomplete: "new-password",
                  aria: { describedby: "password-hint" },
                  class: "h-11 w-full rounded-control border border-border bg-background px-3.5 text-sm text-heading focus:border-border-strong focus:outline-none" %>
            <p id="password-hint" class="mt-1.5 text-xs text-muted">At least 12 characters.</p>
          </div>

          <%= form.submit "Create account",
                class: "h-11 w-full cursor-pointer rounded-control bg-primary px-4 text-sm font-medium text-primary-contrast transition-colors hover:bg-primary-hover" %>
        <% end %>

        <p class="mt-7 text-center text-sm text-muted">
          Already have an account?
          <%= link_to "Log in", login_path,
                class: "font-medium text-primary underline underline-offset-4 hover:text-primary-hover" %>
        </p>
      </div>
    </div>
  </div>
</div>
