<% content_for :title, "Create your Prachar account" %>

<%# Matches the sign-in screen: frosted card on the gradient, underline-only
    fields, centred. The card flips between the two. %>
<div class="auth-orchid">
  <%= render "shared/floating_platforms" %>

  <div class="orchid-layout">

    <div class="auth-enter orchid-card">
      <div class="mb-7 text-center">
        <%= render "shared/wordmark", classes: "text-lg" %>
        <h1 class="orchid-title mt-4">Sign Up</h1>
      </div>

      <%= render "shared/flash" %>
      <%= render "shared/error_summary", record: @user %>

      <%= form_with model: @user, url: signup_path, method: :post, scope: :user, class: "space-y-6",
              data: {
                controller: "account-type",
                account_type_business_value: { label: "Business name", placeholder: "Anaya Bakes", hint: "This becomes your workspace. You can rename it later." }.to_json,
                account_type_influencer_value: { label: "Creator name", placeholder: "@anayabakes", hint: "This becomes your workspace. You can rename it later." }.to_json
              } do |form| %>
        <%#
          Asked here rather than later because it changes what the product calls
          things from this screen onwards. A creator has no "business name", and
          being asked for one is the moment somebody decides this was not built
          for them.

          A fieldset of radios, not a pair of styled divs: arrow keys move
          between them, the choice posts with no JavaScript, and the server
          records it either way. The controller only re-words the field below.
        %>
        <fieldset class="orchid-choice">
          <legend class="sr-only">What kind of account is this?</legend>

          <% [ [ "business", "Business", "A shop, brand or service" ],
               [ "influencer", "Influencer", "A creator or personality" ] ].each do |value, title, note| %>
            <label class="orchid-choice-option">
              <%= form.radio_button :account_type, value,
                    checked: (params.dig(:user, :account_type) || "business") == value,
                    class: "sr-only",
                    data: { action: "account-type#change" } %>
              <span class="orchid-choice-title"><%= title %></span>
              <span class="orchid-choice-note"><%= note %></span>
            </label>
          <% end %>
        </fieldset>

        <div class="orchid-row">
          <%# Visually hidden rather than absent: a placeholder disappears the
              moment somebody types, leaving a filled form with no way to tell
              what each line was for. %>
          <%= form.label :business_name, "Business name", class: "sr-only",
                data: { account_type_target: "label" } %>
          <%= form.text_field :business_name, value: params.dig(:user, :business_name), required: true,
                autofocus: true, placeholder: "Business name", class: "orchid-field",
                data: { account_type_target: "field" } %>
          <%= render "shared/orchid_icons", icon: :user %>
          <p class="orchid-hint mt-1.5 text-xs" data-account-type-target="hint">
            This becomes your workspace. You can rename it later.
          </p>
        </div>

        <div class="orchid-row">
          <%= form.label :name, "Your name", class: "sr-only" %>
          <%= form.text_field :name, required: true, autocomplete: "name",
                placeholder: "Your name", class: "orchid-field" %>
          <%= render "shared/orchid_icons", icon: :user %>
        </div>

        <div class="orchid-row">
          <%= form.label :email, "Email address", class: "sr-only" %>
          <%= form.email_field :email, required: true, autocomplete: "email",
                placeholder: "Email", class: "orchid-field" %>
          <%= render "shared/orchid_icons", icon: :mail %>
        </div>

        <div class="orchid-row" data-controller="password-visibility">
          <%= form.label :password, "Password", class: "sr-only" %>
          <%= form.password_field :password, required: true, minlength: 12, autocomplete: "new-password",
                aria: { describedby: "password-hint" },
                placeholder: "Password", class: "orchid-field",
                data: { password_visibility_target: "field" } %>
          <%# The padlock reads as a show/hide control whether or not it is one,
              so it is one. Rendered decorative first and swapped for the button
              by the controller, so with no JavaScript the line looks exactly as
              it did rather than offering a button that cannot work. %>
          <span data-password-visibility-target="decor"><%= render "shared/orchid_icons", icon: :lock %></span>
          <button type="button" hidden
                  class="orchid-toggle"
                  data-password-visibility-target="button"
                  data-action="password-visibility#toggle"
                  aria-label="Show password">
            <span data-password-visibility-target="eye"><%= render "shared/orchid_icons", icon: :eye %></span>
            <span data-password-visibility-target="eyeOff" hidden><%= render "shared/orchid_icons", icon: :eye_off %></span>
          </button>
          <p id="password-hint" class="orchid-hint mt-1.5 text-xs">
            At least 12 characters.
          </p>
        </div>

        <div class="pt-1">
          <%= form.submit "Sign Up", class: "orchid-button" %>
        </div>
      <% end %>

      <p class="mt-7 text-center text-sm">
        <%= link_to "Already have an account?", login_path, class: "orchid-link" %>
      </p>
    </div>

  </div>
</div>
