<% content_for :title, "Workspace not available" %>

<div class="mx-auto flex min-h-dvh max-w-lg flex-col justify-center px-6 py-16">
  <%= render "shared/wordmark", classes: "text-2xl" %>

  <div class="mt-8 rounded-card border border-border bg-surface p-8 shadow-card">
    <span aria-hidden="true"
          class="mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-gold-tint text-warning">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-6 w-6">
        <circle cx="12" cy="12" r="8.5" />
        <path d="M12 8v4.5M12 16h.01" stroke-linecap="round" />
      </svg>
    </span>

    <h1 class="font-display text-2xl font-normal">That workspace isn't available to you</h1>
    <p class="mt-2 text-sm text-body">
      Either it doesn't exist, or your account isn't a member of it.
      If someone shared this link, ask them to invite you.
    </p>

    <% workspaces = current_user.workspaces.order(:name) %>

    <% if workspaces.any? %>
      <p class="mt-6 text-xs font-semibold uppercase tracking-wide text-primary">
        Workspaces you can open
      </p>
      <ul class="mt-3 space-y-2">
        <% workspaces.each do |workspace| %>
          <li>
            <%= link_to workspace_root_path(workspace_slug: workspace.slug),
                  class: "flex items-center gap-3 rounded-control border border-border bg-background px-4 py-3 hover:border-border-strong" do %>
              <span aria-hidden="true"
                    class="flex h-8 w-8 items-center justify-center rounded-full bg-blue-soft text-xs font-semibold text-primary">
                <%= workspace.name.split.first(2).map { |word| word[0] }.join.upcase %>
              </span>
              <span class="text-sm font-medium text-heading"><%= workspace.name %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-6 text-sm text-body">
        Your account isn't a member of any workspace yet.
      </p>
      <%= link_to "Create a workspace", new_workspace_path,
            class: "mt-4 inline-flex h-11 items-center rounded-control bg-primary px-5 text-sm font-medium text-primary-contrast hover:bg-primary-hover" %>
    <% end %>
  </div>

  <div class="mt-6 flex items-center justify-between gap-3">
    <p class="text-xs text-muted">
      Signed in as <%= current_user.email %>
    </p>
    <%= button_to "Sign out", logout_path, method: :delete,
          class: "cursor-pointer text-sm text-muted underline underline-offset-4 hover:text-heading" %>
  </div>
</div>
