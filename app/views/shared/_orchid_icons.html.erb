<%#
  The little marks at the right-hand end of each field line.

  Decorative only: every field keeps a real <label>, so these say nothing that
  is not already said properly, which is why they are aria-hidden.
%>
<% case icon
   when :user %>
  <svg class="orchid-icon" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
    <path d="M12 12a5 5 0 100-10 5 5 0 000 10zm0 2c-4.4 0-8 2.7-8 6v1h16v-1c0-3.3-3.6-6-8-6z" />
  </svg>
<% when :mail %>
  <svg class="orchid-icon" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
    <path d="M2 6a2 2 0 012-2h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6zm2.4.6L12 12l7.6-5.4V6H4.4v.6zM20 8.6l-7.4 5.2a1 1 0 01-1.2 0L4 8.6V18h16V8.6z" />
  </svg>
<% when :eye %>
  <svg class="orchid-icon" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
    <path d="M12 5c-4.6 0-8.3 3.2-9.8 6.6a1 1 0 000 .8C3.7 15.8 7.4 19 12 19s8.3-3.2 9.8-6.6a1 1 0 000-.8C20.3 8.2 16.6 5 12 5zm0 12c-3.5 0-6.5-2.3-7.8-5 1.3-2.7 4.3-5 7.8-5s6.5 2.3 7.8 5c-1.3 2.7-4.3 5-7.8 5zm0-8.2a3.2 3.2 0 100 6.4 3.2 3.2 0 000-6.4z" />
  </svg>
<% when :eye_off %>
  <svg class="orchid-icon" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
    <path d="M3.3 2.3 2 3.6l3.2 3.2A13 13 0 002.2 11.6a1 1 0 000 .8C3.7 15.8 7.4 19 12 19c1.8 0 3.4-.5 4.8-1.2l3.6 3.6 1.3-1.3zM12 17c-3.5 0-6.5-2.3-7.8-5a11 11 0 012.5-3.1l2.1 2.1a3.2 3.2 0 004.3 4.3l1.4 1.4c-.8.2-1.6.3-2.5.3zm9.8-4.6a1 1 0 000-.8C20.3 8.2 16.6 5 12 5c-1.2 0-2.3.2-3.3.6l1.6 1.6c.6-.1 1.1-.2 1.7-.2 3.5 0 6.5 2.3 7.8 5a11 11 0 01-2.2 2.9l1.4 1.4a13 13 0 002.8-3.9z" />
  </svg>
<% when :lock %>
  <svg class="orchid-icon" aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
    <path d="M7 10V7a5 5 0 0110 0v3h1a2 2 0 012 2v8a2 2 0 01-2 2H6a2 2 0 01-2-2v-8a2 2 0 012-2h1zm2 0h6V7a3 3 0 00-6 0v3zm3 5a1.5 1.5 0 00-.75 2.8V19h1.5v-1.2A1.5 1.5 0 0012 15z" />
  </svg>
<% end %>
