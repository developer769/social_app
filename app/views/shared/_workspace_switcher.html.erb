<div class="rounded-card border border-border bg-background p-3">
  <div class="flex items-center gap-3">
    <span aria-hidden="true"
          class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-blue-soft text-xs font-semibold text-primary">
      <%= current_workspace.name.split.first(2).map { |word| word[0] }.join.upcase %>
    </span>
    <span class="min-w-0 flex-1">
      <span class="block truncate text-sm font-medium text-heading"><%= current_workspace.name %></span>
      <span class="block truncate text-xs text-muted">
        <%= current_workspace.country_code == "IN" ? "India" : current_workspace.country_code %>
      </span>
    </span>
  </div>

  <% if available_workspaces.many? %>
    <%= link_to "Switch workspace", workspaces_path,
          class: "mt-3 block rounded-control border border-border px-3 py-2 text-center text-xs font-medium text-body hover:bg-surface-sunk" %>
  <% end %>

  <%= button_to "Sign out", logout_path, method: :delete,
        class: "mt-2 w-full cursor-pointer rounded-control px-3 py-2 text-xs font-medium text-muted hover:bg-surface-sunk hover:text-heading" %>
</div>
