<% if record.respond_to?(:errors) && record&.errors&.any? %>
  <div role="alert" tabindex="-1"
       class="mb-5 rounded-control border border-danger/30 bg-danger-soft px-4 py-3">
    <h2 class="text-sm font-semibold text-danger">
      <%= pluralize(record.errors.count, "problem") %> stopped this from saving
    </h2>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-danger">
      <% record.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
