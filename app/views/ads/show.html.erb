<% content_for :title, "Ads" %>
<% slug = { workspace_slug: current_workspace.slug } %>
<% r = @readiness %>
<%
  fix_paths = {
    connections: workspace_settings_connections_path(**slug),
    business: workspace_settings_business_path(**slug),
    catalog: workspace_settings_catalog_path(**slug),
    calendar: workspace_calendar_path(**slug)
  }
%>

<header class="mb-6">
  <h1 class="font-display text-3xl font-normal sm:text-4xl">
    Ads<span aria-hidden="true" class="ml-1 align-super text-base text-accent">&#10022;</span>
  </h1>
  <p class="mt-1.5 max-w-prose text-sm text-muted">
    Putting money behind a post, on the platforms that allow it.
  </p>
</header>

<%= render "shared/flash" %>

<%#
  Ads is the one place where a confident-looking guess costs real money. Said
  first, plainly, and without a "coming soon" that implies a date nobody has
  committed to (spec 22, 30).
%>
<% unless r.available? %>
  <section class="mb-6 rounded-card border border-border bg-gold-tint px-5 py-4">
    <div class="flex gap-3">
      <%= render "shared/note_icon", tone: "text-warning" %>
      <div class="text-sm text-body">
        <p>
          <span class="font-medium text-heading">Prachar cannot run ads yet.</span>
          Spending money on a platform needs a connection built for exactly that, with its
          own approval from the platform, and none exists today.
        </p>
        <p class="mt-1.5">
          You will not find estimated reach or a suggested budget on this page. Those are
          numbers Prachar has no way to know, and a guess you could act on is worse than
          an empty space.
        </p>
      </div>
    </div>
  </section>
<% end %>

<%# The dashboard first: it is what somebody comes to this page for. %>
<div class="mb-6 space-y-6">
  <%= render "performance", performance: @performance %>
  <%= render "revenue", performance: @performance %>
</div>

<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
  <div class="min-w-0 space-y-6">
    <%#
      A checklist exists to say what is MISSING. When nothing is, it earns one
      line, not a card per finished item -- and the outstanding ones are what
      stay in view.
    %>
    <% outstanding = r.checks.reject(&:done?) %>

    <section class="rounded-card border border-border bg-surface px-5 py-4">
      <details <%= "open" if outstanding.any? %> class="group">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-3">
          <span class="flex items-center gap-2.5">
            <% if outstanding.empty? %>
              <span aria-hidden="true"
                    class="flex h-5 w-5 items-center justify-center rounded-full bg-success text-xs text-white">&#10003;</span>
              <span class="text-sm font-medium text-heading">
                Everything on your side is in place
              </span>
            <% else %>
              <span aria-hidden="true"
                    class="flex h-5 w-5 items-center justify-center rounded-full border border-border-strong text-xs text-muted">
                <%= outstanding.size %>
              </span>
              <span class="text-sm font-medium text-heading">
                <%= pluralize(outstanding.size, "thing") %> to do before you can advertise
              </span>
            <% end %>
          </span>

          <span class="shrink-0 text-xs tabular-nums text-muted">
            <%= r.ready_count %>/<%= r.total_checks %>
            <span aria-hidden="true" class="ml-1 inline-block transition-transform group-open:rotate-90">&rsaquo;</span>
          </span>
        </summary>

        <ol class="mt-4 space-y-2 border-t border-border pt-4">
          <% r.checks.each do |check| %>
            <li class="flex items-start gap-2.5">
              <span aria-hidden="true"
                    class="mt-1 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border text-[10px]
                           <%= check.done? ? "border-success bg-success text-white" : "border-border-strong text-muted" %>">
                <%= check.done? ? "✓" : "" %>
              </span>

              <span class="min-w-0 flex-1 text-sm">
                <span class="<%= check.done? ? "text-muted" : "font-medium text-heading" %>"><%= check.label %></span>
                <span class="text-muted"> &middot; <%= check.detail %></span>
              </span>

              <% unless check.done? %>
                <%= link_to check.fix_label, fix_paths.fetch(check.fix_path),
                      class: "shrink-0 text-sm font-medium text-primary underline underline-offset-4" %>
              <% end %>
            </li>
          <% end %>
        </ol>
      </details>
    </section>

    <%#
      Reference, not a decision. It never changes, so it sits closed until
      somebody wants it.
    %>
    <section class="rounded-card border border-border bg-surface px-5 py-4">
      <details class="group">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-3">
          <span class="flex flex-wrap items-center gap-2">
            <span class="text-sm font-medium text-heading">Where ads are possible</span>
            <span class="flex items-center gap-1">
              <% r.rows.each do |row| %>
                <%= render PlatformGlyphComponent.new(provider: row.provider, size: :small) %>
              <% end %>
            </span>
          </span>
          <span class="shrink-0 text-xs text-muted">
            <%= r.connected_advertising_platforms.size %> of <%= r.rows.size %> connected
            <span aria-hidden="true" class="ml-1 inline-block transition-transform group-open:rotate-90">&rsaquo;</span>
          </span>
        </summary>

        <p class="mt-4 border-t border-border pt-4 text-sm text-muted">
          Not every platform sells advertising through an API. These are the ones that do.
        </p>

        <ul class="mt-3 space-y-2.5">
          <% r.rows.each do |row| %>
            <li class="flex items-start gap-2.5">
              <%= render PlatformGlyphComponent.new(provider: row.provider, size: :small) %>
              <span class="min-w-0 flex-1">
                <span class="flex flex-wrap items-center gap-2">
                  <span class="text-sm font-medium text-heading"><%= row.name %></span>
                  <% if row.connected %>
                    <%= render StatusBadgeComponent.new(label: "Connected", tone: :success) %>
                  <% else %>
                    <%= render StatusBadgeComponent.new(label: "Not connected", tone: :neutral) %>
                  <% end %>
                </span>
                <span class="mt-0.5 block text-xs text-muted"><%= row.notes %></span>
              </span>
            </li>
          <% end %>
        </ul>

        <%# Named, so their absence is not mistaken for an oversight. %>
        <p class="mt-3 text-xs text-muted">
          YouTube, TikTok and Google Business Profile are not listed because Prachar does
          not use an advertising API for them.
        </p>
      </details>
    </section>
  </div>

  <aside class="space-y-5">
    <section class="rounded-card border border-border bg-blue-soft p-5">
      <h2 class="font-display text-lg font-normal">What this will do</h2>
      <p class="mt-2 text-sm text-body">
        When an advertising connection exists, you will be able to put money behind a post
        that already went out, choose who should see it, set a budget in rupees, and stop it
        at any point.
      </p>
      <p class="mt-3 text-sm text-muted">
        It will always be a post you published first. Advertising something you have never
        run organically means paying to find out what a free post would have told you.
      </p>
    </section>

    <section class="rounded-card border border-border bg-surface p-5">
      <h2 class="font-display text-lg font-normal">In the meantime</h2>
      <p class="mt-2 text-sm text-body">
        The best preparation is posts that already work. Keep publishing, and when ads
        arrive you will know which post deserves the money.
      </p>
      <%= link_to "Plan a post", workspace_create_path(**slug),
            class: "mt-3 inline-flex h-10 items-center rounded-control bg-primary px-4 text-sm font-medium text-primary-contrast hover:bg-primary-hover" %>
    </section>
  </aside>
</div>
