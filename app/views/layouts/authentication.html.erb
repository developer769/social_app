<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Prachar" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <%= render "shared/fonts" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <%# auth-ocean swaps the design tokens for the sign-in palette; nothing
      outside this layout sees it. %>
  <body class="auth-ocean min-h-dvh bg-background text-body antialiased">
    <%= yield %>
    <footer class="pb-8 text-center text-xs text-muted">
      <%= link_to "Privacy", privacy_path, class: "underline underline-offset-4 hover:text-heading" %>
      &middot;
      <%= link_to "Terms", terms_path, class: "underline underline-offset-4 hover:text-heading" %>
      &middot;
      <%= link_to "Delete my data", data_deletion_path, class: "underline underline-offset-4 hover:text-heading" %>
    </footer>
  </body>
</html>
