<% content_for :title, @workspaces.any? ? "Choose a workspace" : "No workspace yet" %>

<div class="mx-auto flex min-h-dvh max-w-lg flex-col justify-center px-6 py-16">
  <%= render "shared/wordmark", classes: "text-2xl" %>

  <% if @workspaces.any? %>
    <h1 class="mt-8 font-display text-3xl font-normal">Choose a workspace</h1>
    <p class="mt-2 text-sm text-muted">You have access to more than one business.</p>

    <ul class="mt-8 space-y-3">
      <% @workspaces.each do |workspace| %>
        <li>
          <%= link_to workspace_root_path(workspace_slug: workspace.slug),
                class: "flex items-center gap-3 rounded-card border border-border bg-surface px-4 py-3.5 hover:border-border-strong" do %>
            <span aria-hidden="true"
                  class="flex h-9 w-9 items-center justify-center rounded-full bg-blue-soft text-xs font-semibold text-primary">
              <%= workspace.name.split.first(2).map { |word| word[0] }.join.upcase %>
            </span>
            <span class="text-sm font-medium text-heading"><%= workspace.name %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <%#
      Reachable when someone's only membership has been removed. Without this
      they were signed in with an empty list, no create action and no sign-out.
    %>
    <h1 class="mt-8 font-display text-3xl font-normal">You're not part of any workspace yet</h1>
    <p class="mt-2 text-sm text-body">
      Your access to every business you belonged to has been removed.
      Ask whoever invited you to add you again, or set up your own business.
    </p>
  <% end %>

  <div class="mt-8 flex flex-wrap items-center gap-3">
    <%= link_to "Create a workspace", new_workspace_path,
          class: "flex h-11 items-center rounded-control bg-primary px-5 text-sm font-medium text-primary-contrast hover:bg-primary-hover" %>
    <%= button_to "Sign out", logout_path, method: :delete,
          class: "h-11 cursor-pointer rounded-control border border-border px-5 text-sm font-medium text-body hover:bg-surface-sunk" %>
  </div>
</div>
