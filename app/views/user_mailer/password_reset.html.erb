<div style="font-family: -apple-system, Segoe UI, sans-serif; color: #485064; line-height: 1.6;">
  <p style="font-size: 20px; color: #22113A; margin: 0 0 16px;">Set a new password</p>

  <p>
    Somebody asked to reset the password for this address. Use the button below to
    choose a new one.
  </p>

  <p style="margin: 28px 0;">
    <a href="<%= @url %>"
       style="background:#341044; color:#FFFDF9; padding:12px 24px; border-radius:8px; text-decoration:none; font-weight:500;">
      Set a new password
    </a>
  </p>

  <p style="font-size: 14px; color: #6E7385;">
    This link works once, and only for the next <%= pluralize(@expires_in_hours, "hour") %>.
  </p>

  <%# If they did not ask, doing nothing is genuinely the right action. %>
  <p style="font-size: 14px; color: #6E7385;">
    If you did not ask for this, you can ignore it. Your password stays as it is and
    nobody has been given access.
  </p>
</div>
