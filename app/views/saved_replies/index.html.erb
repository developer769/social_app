<% content_for :title, "Saved replies" %>
<% slug = { workspace_slug: current_workspace.slug } %>

<header class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div>
    <%= link_to "← Inbox", workspace_inbox_path(**slug),
          class: "text-sm text-muted underline underline-offset-4 hover:text-heading" %>
    <h1 class="mt-3 font-display text-3xl font-normal sm:text-4xl">Saved replies</h1>
    <p class="mt-1.5 max-w-prose text-sm text-muted">
      The answers you give most often, written once. Useful even now: Prachar cannot
      reply for you yet, but it can keep the answer ready to copy.
    </p>
  </div>

  <%= link_to "Write a reply", new_workspace_saved_reply_path(**slug),
        class: "flex h-11 items-center rounded-control bg-primary px-5 text-sm font-medium text-primary-contrast hover:bg-primary-hover" %>
</header>

<%= render "shared/flash" %>

<% if @saved_replies.empty? %>
  <%= render EmptyStateComponent.new(
        icon: :inbox,
        title: "Nothing written yet",
        body: "Start with the questions you answer every week: where you deliver, when you open, what things cost.") do |state| %>
    <% state.with_action do %>
      <%= link_to "Write your first", new_workspace_saved_reply_path(**slug),
            class: "inline-flex h-11 items-center rounded-control bg-primary px-5 text-sm font-medium text-primary-contrast hover:bg-primary-hover" %>
    <% end %>
  <% end %>
<% else %>
  <ul class="divide-y divide-border rounded-card border border-border bg-surface">
    <% @saved_replies.each do |reply| %>
      <li class="flex items-start gap-4 px-5 py-4">
        <div class="min-w-0 flex-1">
          <p class="text-sm font-medium text-heading"><%= reply.title %></p>
          <p class="mt-1 whitespace-pre-wrap text-sm text-body"><%= reply.body %></p>
          <% if reply.times_used.positive? %>
            <p class="mt-1.5 text-xs text-muted">Used <%= pluralize(reply.times_used, "time") %></p>
          <% end %>
        </div>

        <div class="flex shrink-0 items-center gap-2">
          <%= link_to "Edit", edit_workspace_saved_reply_path(**slug, id: reply),
                class: "rounded-control px-3 py-1.5 text-sm font-medium text-body hover:bg-surface-sunk" %>
          <%= button_to "Delete", workspace_saved_reply_path(**slug, id: reply), method: :delete,
                form: { data: { turbo_confirm: "Delete \"#{reply.title}\"?" } },
                class: "cursor-pointer rounded-control px-3 py-1.5 text-sm font-medium text-danger hover:bg-danger-soft" %>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
