<% content_for :title, "Inbox" %>
<% slug = { workspace_slug: current_workspace.slug } %>
<% closed_view = params[:status] == "closed" %>

<header class="mb-6 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="font-display text-3xl font-normal sm:text-4xl">
      Inbox<span aria-hidden="true" class="ml-1 align-super text-base text-accent">&#10022;</span>
    </h1>
    <p class="mt-1.5 text-sm text-muted">
      Comments, messages and reviews from the accounts you have connected.
    </p>
  </div>

  <%= link_to "Saved replies", workspace_saved_replies_path(**slug),
        class: "flex h-10 items-center rounded-control border border-border px-4 text-sm font-medium text-body hover:bg-surface-sunk" %>
</header>

<%= render "shared/flash" %>

<%#
  The honest state, said before the empty list rather than after it. An empty
  inbox with no explanation reads as "nobody has messaged you", which is a
  claim about the business rather than about Prachar (spec 27, 30).
%>
<% unless @reach.live? %>
  <section class="mb-6 flex gap-3 rounded-card border border-border bg-gold-tint px-5 py-4">
    <%= render "shared/note_icon", tone: "text-warning" %>
    <div class="text-sm text-body">
      <p>
        <span class="font-medium text-heading">Prachar cannot read your messages yet.</span>
        <% if @reach.waiting_on.any? %>
          No connection to <%= @reach.waiting_on.to_sentence %> has been built, so nothing
          arrives here. This is not an empty inbox &mdash; it is one that has never been filled.
        <% else %>
          Connect an account first, and anything it can read will arrive here.
        <% end %>
      </p>
      <p class="mt-1.5">
        Until then, your saved replies are still worth writing: keep the answers you give
        most often ready to copy into the platform's own app.
      </p>
    </div>
  </section>
<% end %>

<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
  <div class="min-w-0 space-y-5">
    <nav class="flex flex-wrap items-center gap-2">
      <% [["Open", nil], ["Done", "closed"]].each do |label, value| %>
        <%= link_to label, workspace_inbox_path(**slug, status: value, kind: @kind, provider: @provider),
              class: class_names(
                "flex h-9 items-center rounded-pill border px-3.5 text-sm font-medium",
                "border-primary bg-primary text-primary-contrast" => closed_view == (value == "closed"),
                "border-border bg-surface text-body hover:bg-surface-sunk" => closed_view != (value == "closed")) %>
      <% end %>

      <span aria-hidden="true" class="mx-1 h-5 w-px bg-border"></span>

      <%#
        Only the kinds the connected platforms can actually deliver. Offering a
        "Messages" filter to somebody whose only platform has no message API
        would be a promise the API cannot keep.
      %>
      <% available_kinds = @reach.rows.flat_map(&:reads).uniq %>
      <% { "comment" => "Comments", "direct_message" => "Messages", "review" => "Reviews" }.each do |value, label| %>
        <% next unless available_kinds.include?(label) %>
        <%= link_to label, workspace_inbox_path(**slug, kind: (value unless @kind == value),
                                                status: params[:status], provider: @provider),
              class: class_names(
                "flex h-9 items-center rounded-pill border px-3.5 text-sm font-medium",
                "border-primary bg-gold-tint text-heading" => @kind == value,
                "border-border bg-surface text-body hover:bg-surface-sunk" => @kind != value) %>
      <% end %>
    </nav>

    <% if @conversations.empty? %>
      <%= render EmptyStateComponent.new(
        icon: :inbox,
        title: closed_view ? "Nothing marked done" : (@reach.live? ? "Nothing waiting" : "Nothing has arrived"),
            body: if closed_view
                    "Conversations you mark done will be kept here."
                  elsif @reach.live?
                    "Everything has been answered."
                  else
                    "Once a connection to your platforms exists, comments and messages will appear here."
                  end) %>
    <% else %>
      <ul class="divide-y divide-border rounded-card border border-border bg-surface">
        <% @conversations.each do |conversation| %>
          <li>
            <%= link_to workspace_conversation_path(**slug, id: conversation),
                  class: "flex items-start gap-3.5 px-5 py-4 hover:bg-surface-sunk" do %>
              <%= render PlatformGlyphComponent.new(provider: conversation.provider, size: :small) %>

              <span class="min-w-0 flex-1">
                <span class="flex flex-wrap items-center gap-2">
                  <span class="text-sm font-medium text-heading"><%= conversation.participant_label %></span>
                  <span class="text-xs text-muted"><%= conversation.kind_label %></span>
                  <% if conversation.awaiting_reply? %>
                    <%= render StatusBadgeComponent.new(label: "Waiting on you", tone: :warning) %>
                  <% end %>
                </span>
                <span class="mt-1 block truncate text-sm text-body"><%= conversation.preview %></span>
              </span>

              <span class="shrink-0 text-xs text-muted">
                <%= time_ago_in_words(conversation.last_message_at) if conversation.last_message_at %>
              </span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <aside class="space-y-5">
    <section class="rounded-card border border-border bg-surface p-5">
      <h2 class="font-display text-lg font-normal">What Prachar can read</h2>
      <p class="mt-1 text-xs text-muted">Different platforms allow different things.</p>

      <% if @reach.rows.empty? %>
        <p class="mt-3 text-sm text-muted">No accounts connected yet.</p>
        <%= link_to "Connect an account", workspace_settings_connections_path(**slug),
              class: "mt-3 inline-block text-sm font-medium text-primary underline underline-offset-4" %>
      <% else %>
        <ul class="mt-3 space-y-3">
          <% @reach.rows.each do |row| %>
            <li class="flex items-start gap-2.5">
              <%= render PlatformGlyphComponent.new(provider: row.provider, size: :small) %>
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-medium text-heading"><%= row.name %></span>
                <span class="block text-xs text-muted">
                  <% if row.unreachable? %>
                    <%# Never, not "not yet". This platform publishes no such API. %>
                    Offers no way to read comments or messages, so nothing from here
                    will ever appear in an inbox.
                  <% else %>
                    <%= row.reads.to_sentence %><%= row.connected ? "" : " — once connected" %>
                  <% end %>
                </span>
              </span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section class="rounded-card border border-border bg-blue-soft p-5">
      <div class="flex items-center justify-between gap-3">
        <h2 class="font-display text-lg font-normal">Saved replies</h2>
        <%= link_to "Add", new_workspace_saved_reply_path(**slug),
              class: "text-sm font-medium text-primary underline underline-offset-4" %>
      </div>

      <% if @saved_replies.empty? %>
        <p class="mt-2 text-sm text-body">
          Write the answers you give most often &mdash; delivery areas, opening hours,
          prices &mdash; and keep them ready to copy.
        </p>
      <% else %>
        <ul class="mt-3 space-y-2">
          <% @saved_replies.each do |reply| %>
            <li class="rounded-control bg-surface px-3.5 py-2.5">
              <p class="text-sm font-medium text-heading"><%= reply.title %></p>
              <p class="mt-0.5 line-clamp-2 text-xs text-muted"><%= reply.body %></p>
            </li>
          <% end %>
        </ul>
        <%= link_to "Manage all", workspace_saved_replies_path(**slug),
              class: "mt-3 inline-block text-sm font-medium text-primary underline underline-offset-4" %>
      <% end %>
    </section>
  </aside>
</div>
