<% content_for :title, "Edit post" %>

<header class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <%= link_to "← Back to calendar", workspace_calendar_path(workspace_slug: current_workspace.slug),
          class: "text-sm text-muted underline underline-offset-4 hover:text-heading" %>
    <h1 class="mt-3 font-display text-3xl font-normal sm:text-4xl">Edit post</h1>
    <p class="mt-1.5 text-sm">
      <%= render StatusBadgeComponent.new(label: @post.status_label, tone: @post.status_tone) %>
      <% if @post.scheduled? %>
        <span class="ml-2 text-muted">
          Goes out <%= @post.scheduled_at_local.strftime("%-d %B at %-l:%M %p") %>
        </span>
      <% end %>
    </p>
  </div>

  <div class="flex flex-wrap gap-2">
    <% if @post.scheduled? %>
      <%= button_to "Move back to draft",
            unschedule_workspace_post_path(workspace_slug: current_workspace.slug, id: @post),
            method: :patch,
            class: "h-11 cursor-pointer rounded-control border border-border px-5 text-sm font-medium text-body hover:bg-surface-sunk" %>
    <% end %>

    <%= button_to "Delete", workspace_post_path(workspace_slug: current_workspace.slug, id: @post),
          method: :delete,
          form: { data: { turbo_confirm: "Delete this post? This cannot be undone." } },
          class: "h-11 cursor-pointer rounded-control border border-border px-5 text-sm font-medium text-danger hover:bg-danger-soft" %>
  </div>
</header>

<%= render "shared/flash" %>
<%= render "form", post: @post, accounts: @accounts %>
