<% content_for :title, "Add a style" %>

<header class="mb-6">
  <%= link_to "← Back to #{@template.format_video? ? 'video' : 'photo'} styles",
          admin_templates_path(media_format: @template.media_format),
        class: "text-sm text-muted underline underline-offset-4 hover:text-heading" %>
  <h1 class="mt-3 font-display text-3xl font-normal">
    Add a <%= @template.format_video? ? "video" : "photo" %> style
  </h1>
  <p class="mt-1.5 text-sm text-muted">
    Saved as a draft first. Nothing reaches a customer until you publish it.
  </p>
</header>

<%= render "form", template: @template %>
