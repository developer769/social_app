<% content_for :title, "Gallery styles" %>

<header class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="font-display text-3xl font-normal">Gallery styles</h1>
    <p class="mt-1.5 text-sm text-muted">
      What every business sees in their gallery. Published styles are live immediately.
    </p>
  </div>

  <%= link_to "Add a style", new_admin_template_path,
        class: "flex h-11 items-center rounded-control bg-primary px-5 text-sm font-medium text-primary-contrast hover:bg-primary-hover" %>
</header>

<nav class="mb-6 inline-flex rounded-control border border-border bg-surface p-1" aria-label="Filter styles">
  <% [["published", "Published"], ["drafts", "Drafts"], ["retired", "Retired"]].each do |value, label| %>
    <% active = @scope == value %>
    <%= link_to admin_templates_path(scope: value),
          aria: { current: (active ? "page" : nil) },
          class: class_names(
            "rounded-[0.4rem] px-4 py-2 text-sm transition-colors",
            "bg-primary font-medium text-primary-contrast" => active,
            "text-body hover:bg-surface-sunk" => !active
          ) do %>
      <%= label %>
      <span class="<%= active ? "text-primary-contrast/70" : "text-muted" %>">
        <%= @counts[value] %>
      </span>
    <% end %>
  <% end %>
</nav>

<% if @templates.empty? %>
  <%= render EmptyStateComponent.new(
        title: "Nothing here yet",
        body: @scope == "published" ? "Add a style and publish it to put it in every gallery." : "Nothing in this state.") %>
<% else %>
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @templates.each do |template| %>
      <li>
        <article class="flex h-full flex-col overflow-hidden rounded-card border border-border bg-surface">
          <div class="relative aspect-4/5 bg-surface-sunk">
            <% if template.preview.attached? %>
              <%= image_tag template.preview.variant(resize_to_fill: [600, 750]),
                    alt: "Preview of #{template.name}",
                    class: "h-full w-full object-cover" %>
            <% else %>
              <span class="flex h-full items-center justify-center text-xs text-muted">No preview yet</span>
            <% end %>

            <div class="absolute left-3 top-3 flex flex-wrap gap-1.5">
              <%= render StatusBadgeComponent.new(
                    label: template.format_video? ? "Video" : "Photo",
                    tone: :info) %>
              <% if template.premium? %>
                <%= render StatusBadgeComponent.new(label: "Premium", tone: :highlight) %>
              <% end %>
            </div>
          </div>

          <div class="flex flex-1 flex-col p-4">
            <p class="font-medium text-heading"><%= template.name %></p>
            <p class="mt-0.5 text-xs text-muted">
              <%= template.category_label %>
              <% if template.format_video? && template.duration_label %>
                &middot; <%= template.duration_label %>
              <% end %>
            </p>

            <p class="mt-2 text-xs text-muted">
              <% if template.retired? %>
                Retired <%= time_ago_in_words(template.retired_at) %> ago
              <% elsif template.published? %>
                Published <%= time_ago_in_words(template.published_at) %> ago<%= " by #{template.published_by.name}" if template.published_by %>
              <% else %>
                Draft &mdash; not visible to customers
              <% end %>
            </p>

            <div class="mt-auto pt-4">
              <%= link_to "Edit", edit_admin_template_path(template),
                    class: "flex h-10 items-center justify-center rounded-control border border-border text-sm font-medium text-body hover:bg-surface-sunk" %>
            </div>
          </div>
        </article>
      </li>
    <% end %>
  </ul>
<% end %>
