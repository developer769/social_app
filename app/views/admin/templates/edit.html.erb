<% content_for :title, @template.name %>

<header class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <%= link_to "← Back to #{@template.format_video? ? 'video' : 'photo'} styles",
          admin_templates_path(media_format: @template.media_format),
          class: "text-sm text-muted underline underline-offset-4 hover:text-heading" %>
    <h1 class="mt-3 font-display text-3xl font-normal"><%= @template.name %></h1>

    <p class="mt-1.5 text-sm">
      <% if @template.retired? %>
        <%= render StatusBadgeComponent.new(label: "Retired", tone: :neutral) %>
        <span class="ml-2 text-muted">Hidden from the gallery. Posts already made with it still work.</span>
      <% elsif @template.published? %>
        <%= render StatusBadgeComponent.new(label: "Live", tone: :success) %>
        <span class="ml-2 text-muted">Visible in every workspace's gallery.</span>
      <% else %>
        <%= render StatusBadgeComponent.new(label: "Draft", tone: :warning) %>
        <span class="ml-2 text-muted">Not visible to customers.</span>
      <% end %>
    </p>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <% if @template.published? %>
      <%= button_to "Move back to draft", unpublish_admin_template_path(@template),
            form: { data: { turbo_confirm: "Hide #{@template.name} from every gallery?" } },
            class: "h-11 cursor-pointer rounded-control border border-border px-5 text-sm font-medium text-body hover:bg-surface-sunk" %>
    <% elsif !@template.retired? %>
      <%= button_to "Publish to all galleries", publish_admin_template_path(@template),
            form: { data: { turbo_confirm: "Publish #{@template.name}? Every business will see it immediately." } },
            class: "h-11 cursor-pointer rounded-control bg-primary px-5 text-sm font-medium text-primary-contrast hover:bg-primary-hover" %>
    <% end %>

    <% unless @template.retired? %>
      <%= button_to "Retire", retire_admin_template_path(@template),
            form: { data: { turbo_confirm: "Retire #{@template.name}? It leaves the gallery permanently. Posts already made with it are unaffected." } },
            class: "h-11 cursor-pointer rounded-control border border-border px-5 text-sm font-medium text-danger hover:bg-danger-soft" %>
    <% end %>
  </div>
</header>

<%= render "form", template: @template %>
