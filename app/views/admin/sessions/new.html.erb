<% content_for :title, "Prachar staff sign in" %>

<div class="mx-auto flex min-h-dvh max-w-md flex-col justify-center px-6 py-16">
  <div class="flex items-center gap-3">
    <%= render "shared/wordmark", classes: "text-2xl" %>
    <span class="rounded-pill border border-primary/30 bg-lavender-soft px-2.5 py-1 text-xs font-medium text-primary">
      Staff
    </span>
  </div>

  <div class="mt-8 rounded-card border border-border bg-surface p-8 shadow-card">
    <h1 class="font-display text-2xl font-normal">Sign in to the staff area</h1>
    <p class="mt-2 text-sm text-muted">
      This is not a customer account. Publishing here changes what every business sees.
    </p>

    <%= render "shared/flash" %>

    <%= form_with url: admin_login_path, method: :post, class: "mt-6 space-y-5" do |form| %>
      <div>
        <%= form.label :email, "Email address", class: "mb-1.5 block text-sm font-medium text-heading" %>
        <%= form.email_field :email, required: true, autofocus: true, autocomplete: "email",
              class: "h-11 w-full rounded-control border border-border bg-background px-3.5 text-sm text-heading focus:border-border-strong focus:outline-none" %>
      </div>

      <div>
        <%= form.label :password, "Password", class: "mb-1.5 block text-sm font-medium text-heading" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password",
              class: "h-11 w-full rounded-control border border-border bg-background px-3.5 text-sm text-heading focus:border-border-strong focus:outline-none" %>
      </div>

      <%= form.submit "Sign in",
            class: "h-11 w-full cursor-pointer rounded-control bg-primary px-4 text-sm font-medium text-primary-contrast hover:bg-primary-hover" %>
    <% end %>
  </div>
</div>
