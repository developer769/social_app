<% content_for :title, "#{current_workspace.name} on Prachar" %>
<% slug = { workspace_slug: current_workspace.slug } %>
<% o = @overview %>
<% zone = current_workspace.timezone %>

<header class="mb-7 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="font-display text-3xl font-normal sm:text-4xl">Home</h1>
    <p class="mt-1.5 text-sm text-muted">
      <%= current_workspace.name %> &middot;
      <%= Time.current.in_time_zone(zone).strftime("%A %-d %B") %>
    </p>
  </div>

  <%= link_to workspace_create_path(**slug),
        class: "flex h-11 items-center gap-2 rounded-control bg-primary px-5 text-sm font-medium text-primary-contrast hover:bg-primary-hover" do %>
    <span aria-hidden="true">+</span> Create post
  <% end %>
</header>

<%= render "shared/flash" %>

<% unless current_workspace.onboarding_completed? %>
  <%# A workspace mid-setup gets a way back into it rather than an empty
      dashboard that looks broken. %>
  <section class="mb-6 rounded-card border border-border bg-gold-tint p-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0">
        <h2 class="font-display text-xl font-normal">Finish setting up <%= current_workspace.name %></h2>
        <p class="mt-1.5 max-w-prose text-sm text-body">
          You are on step <%= OnboardingFlow.index_of(current_workspace.onboarding_step).to_i + 1 %>
          of <%= OnboardingFlow.keys.size %>:
          <span class="font-medium text-heading"><%= OnboardingFlow.step(current_workspace.onboarding_step)&.dig(:label) %></span>.
          Prachar writes better content once it knows your brand and what you sell.
        </p>
      </div>

      <%= link_to "Continue setup", workspace_onboarding_path(**slug),
            class: "flex h-11 shrink-0 items-center rounded-control bg-primary px-5 text-sm font-medium text-primary-contrast hover:bg-primary-hover" %>
    </div>
  </section>
<% end %>

<%#
  Anything wrong comes first, before any figure. A dashboard that opens with
  counts makes somebody read four numbers before finding out a post failed.
%>
<% if o.attention.any? %>
  <section class="mb-6" aria-labelledby="attention-heading">
    <h2 id="attention-heading" class="mb-3 text-xs font-semibold uppercase tracking-wide text-muted">
      Needs you
    </h2>

    <ul class="grid gap-3">
      <% o.attention.each do |item| %>
        <% tone = attention_tone(item.severity) %>
        <li class="flex flex-wrap items-start gap-3.5 rounded-card border <%= tone[:border] %> <%= tone[:bg] %> px-5 py-4">
          <span aria-hidden="true" class="mt-0.5 text-sm <%= tone[:mark] %>"><%= tone[:glyph] %></span>

          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-heading"><%= item.title %></p>
            <p class="mt-0.5 text-sm text-body"><%= item.detail %></p>
          </div>

          <%= link_to item.action, dashboard_path_for(item.path),
                class: "shrink-0 text-sm font-medium text-primary underline underline-offset-4" %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<section class="mb-6" aria-labelledby="figures-heading">
  <h2 id="figures-heading" class="sr-only">At a glance</h2>

  <dl class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
    <% o.figures.each do |figure| %>
      <%= link_to dashboard_path_for(figure.path),
            class: "rounded-card border border-border bg-surface p-5 transition-shadow hover:shadow-card" do %>
        <dt class="text-sm text-muted"><%= figure.label %></dt>
        <dd class="mt-1 font-display text-3xl tabular-nums text-heading"><%= figure.value %></dd>
        <dd class="mt-1 text-xs text-muted"><%= figure.hint %></dd>
      <% end %>
    <% end %>
  </dl>
</section>

<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
  <div class="min-w-0 space-y-6">
    <section class="rounded-card border border-border bg-surface p-6">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="font-display text-xl font-normal">Coming up</h2>
        <%= link_to "Open the calendar", workspace_calendar_path(**slug),
              class: "text-sm font-medium text-primary underline underline-offset-4" %>
      </div>

      <% if o.upcoming.empty? %>
        <p class="mt-3 text-sm text-muted">
          Nothing is scheduled. Anything you plan appears here with its time.
        </p>
      <% else %>
        <ul class="mt-4 divide-y divide-border">
          <% o.upcoming.each do |post| %>
            <li>
              <%= link_to workspace_post_path(**slug, id: post),
                    class: "flex items-start gap-3.5 py-3.5 hover:opacity-80" do %>
                <% provider = post.providers.first %>
                <% if provider %>
                  <%= render PlatformGlyphComponent.new(provider: provider, size: :small) %>
                <% else %>
                  <span aria-hidden="true" class="h-5 w-5 shrink-0 rounded-full bg-surface-sunk"></span>
                <% end %>

                <span class="min-w-0 flex-1">
                  <span class="block truncate text-sm font-medium text-heading">
                    <%= post.caption.presence&.truncate(60) || post.template&.name || "Untitled post" %>
                  </span>
                  <span class="mt-0.5 block text-xs text-muted">
                    <%= post.scheduled_at_local&.strftime("%a %-d %b, %-l:%M %p") %>
                    <% if post.publish_reminder? %>
                      &middot; you will be reminded to post it
                    <% end %>
                  </span>
                </span>

                <%= render StatusBadgeComponent.new(label: post.status_label, tone: post.status_tone) %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>

      <% if o.drafts.any? %>
        <div class="mt-5 border-t border-border pt-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-muted">Unfinished drafts</p>
          <ul class="mt-2.5 space-y-1.5">
            <% o.drafts.each do |draft| %>
              <li>
                <%= link_to edit_workspace_post_path(**slug, id: draft),
                      class: "block truncate text-sm text-body underline underline-offset-4 hover:text-heading" do %>
                  <%= draft.caption.presence&.truncate(60) || draft.template&.name || "Untitled draft" %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </section>

    <%#
      The same rhythm figure Analytics shows, because it is the one number that
      answers "am I actually keeping this up" -- which is a homepage question.
      Everything else about performance stays on Analytics.
    %>
    <section class="rounded-card border border-border bg-surface p-6">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="font-display text-xl font-normal">Your rhythm</h2>
        <%= link_to "Full analytics", workspace_analytics_path(**slug),
              class: "text-sm font-medium text-primary underline underline-offset-4" %>
      </div>

      <% a = o.analytics %>
      <p class="mt-1 text-sm text-muted">
        <% if a.target_per_week.blank? %>
          Set how often you want to post and this will compare against it.
        <% elsif a.enough_history_to_compare? %>
          You wanted <%= pluralize(a.target_per_week, "post") %> a week and have averaged
          <%= a.average_per_week %>.
        <% else %>
          You wanted <%= pluralize(a.target_per_week, "post") %> a week.
          <%= pluralize(a.this_week_count, "post") %> so far this week.
        <% end %>
      </p>

      <% if a.anything_happened? %>
        <% peak = [ a.weekly_activity.map(&:count).max || 0, a.target_per_week || 0, 1 ].max %>
        <ol class="mt-4 flex items-end gap-1.5" style="height: 5.5rem;">
          <% a.weekly_activity.each do |point| %>
            <li class="flex h-full flex-1 flex-col justify-end"
                title="Week of <%= point.starts_on.strftime('%-d %b') %>: <%= pluralize(point.count, 'post') %>">
              <span class="block w-full rounded-t-sm <%= point.count.zero? ? "bg-border" : "bg-primary" %>"
                    style="height: <%= [ (point.count.to_f / peak * 100).round, 2 ].max %>%"></span>
            </li>
          <% end %>
        </ol>
        <div class="mt-2 flex justify-between text-xs text-muted">
          <span><%= a.weekly_activity.first&.starts_on&.strftime("%-d %b") %></span>
          <span>This week</span>
        </div>
      <% else %>
        <p class="mt-3 text-sm text-muted">Nothing has gone out yet, so there is no rhythm to show.</p>
      <% end %>
    </section>
  </div>

  <aside class="space-y-6">
    <section class="rounded-card border border-border bg-surface p-5">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="font-display text-lg font-normal">Your accounts</h2>
        <%= link_to "Manage", workspace_settings_connections_path(**slug),
              class: "text-sm font-medium text-primary underline underline-offset-4" %>
      </div>

      <% if o.accounts.empty? %>
        <p class="mt-2 text-sm text-muted">Nothing connected yet.</p>
      <% else %>
        <ul class="mt-3 space-y-3">
          <% o.accounts.each do |account| %>
            <li class="flex items-center gap-2.5">
              <%= render PlatformGlyphComponent.new(provider: account.provider, size: :small) %>
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm text-heading"><%= account.provider_name %></span>
                <span class="block truncate text-xs text-muted"><%= account.handle %></span>
              </span>

              <% if !account.usable_for_publishing? %>
                <%= render StatusBadgeComponent.new(label: "Reconnect", tone: :danger) %>
              <% elsif account.token_expiring_soon? %>
                <%= render StatusBadgeComponent.new(label: "Expiring", tone: :warning) %>
              <% else %>
                <%= render StatusBadgeComponent.new(label: "Connected", tone: :success) %>
              <% end %>
            </li>
          <% end %>
        </ul>

        <%# Spec 27, on the screen people see most. %>
        <% if o.accounts.all?(&:mocked?) %>
          <p class="mt-4 border-t border-border pt-3 text-xs text-muted">
            These are simulated. Prachar cannot post to them or read figures from them yet.
          </p>
        <% end %>
      <% end %>
    </section>

    <section class="rounded-card border border-border bg-surface p-5">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="font-display text-lg font-normal">Lately</h2>
        <%= link_to "All activity", workspace_settings_activity_path(**slug),
              class: "text-sm font-medium text-primary underline underline-offset-4" %>
      </div>

      <% if o.recent_activity.empty? %>
        <p class="mt-2 text-sm text-muted">Nothing has happened yet.</p>
      <% else %>
        <ul class="mt-3 space-y-2.5">
          <% o.recent_activity.each do |entry| %>
            <li class="flex items-start gap-2.5">
              <span aria-hidden="true"
                    class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full
                           <%= { success: "bg-success", danger: "bg-danger" }.fetch(entry.tone, "bg-border-strong") %>"></span>
              <span class="min-w-0 flex-1 text-sm text-body">
                <span class="font-medium text-heading"><%= entry.actor_name %></span>
                <%= entry.sentence %>
                <span class="block text-xs text-muted">
                  <%= time_ago_in_words(entry.occurred_at) %> ago
                </span>
              </span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <% if o.analytics.never_featured.any? %>
      <section class="rounded-card border border-border bg-blue-soft p-5">
        <h2 class="font-display text-lg font-normal">Not posted about yet</h2>
        <p class="mt-1.5 text-sm text-body">
          <%= pluralize(o.analytics.never_featured.size, "thing") %> in your catalog that no post
          has featured.
        </p>
        <ul class="mt-3 space-y-1.5">
          <% o.analytics.never_featured.first(4).each do |item| %>
            <li class="truncate text-sm text-body"><%= item.name %></li>
          <% end %>
        </ul>
        <%= link_to "Make a post about one", workspace_gallery_path(**slug),
              class: "mt-3 inline-block text-sm font-medium text-primary underline underline-offset-4" %>
      </section>
    <% end %>
  </aside>
</div>
