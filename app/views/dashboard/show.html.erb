<% content_for :title, "#{current_workspace.name} on Prachar" %>

<header class="mb-7 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="font-display text-3xl font-normal sm:text-4xl">Home</h1>
    <p class="mt-1.5 text-sm text-muted">Track your content performance and grow your brand.</p>
  </div>

  <%= link_to workspace_onboarding_path(workspace_slug: current_workspace.slug),
        class: "flex h-11 items-center gap-2 rounded-control bg-primary px-5 text-sm font-medium text-primary-contrast hover:bg-primary-hover" do %>
    <span aria-hidden="true">+</span> Create post
  <% end %>
</header>

<%= render "shared/flash" %>

<% unless current_workspace.onboarding_completed? %>
  <%# A workspace mid-setup gets a way back into it rather than an empty
      dashboard that looks broken. %>
  <section class="mb-6 rounded-card border border-border bg-gold-tint p-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0">
        <h2 class="font-display text-xl font-normal">Finish setting up <%= current_workspace.name %></h2>
        <p class="mt-1.5 max-w-prose text-sm text-body">
          You are on step <%= OnboardingFlow.index_of(current_workspace.onboarding_step).to_i + 1 %>
          of <%= OnboardingFlow.keys.size %>:
          <span class="font-medium text-heading">
            <%= OnboardingFlow.step(current_workspace.onboarding_step)&.dig(:label) %>
          </span>.
          Prachar writes better content once it knows your brand and what you sell.
        </p>
      </div>

      <%= link_to "Continue setup", workspace_onboarding_path(workspace_slug: current_workspace.slug),
            class: "flex h-11 shrink-0 items-center rounded-control bg-primary px-5 text-sm font-medium text-primary-contrast hover:bg-primary-hover" %>
    </div>
  </section>
<% end %>

<div class="rounded-card border border-border bg-surface p-8 shadow-panel">
  <h2 class="font-display text-2xl font-normal">Welcome, <%= current_user.name.split.first %>.</h2>
  <p class="mt-2 max-w-prose text-sm text-body">
    Performance figures appear here once a real social account is connected and has published posts.
    Nothing is estimated in the meantime.
  </p>

  <dl class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="rounded-control border border-border bg-background px-4 py-3">
      <dt class="text-xs text-muted">Workspace</dt>
      <dd class="mt-0.5 text-sm font-medium text-heading"><%= current_workspace.name %></dd>
    </div>
    <div class="rounded-control border border-border bg-background px-4 py-3">
      <dt class="text-xs text-muted">Catalog</dt>
      <dd class="mt-0.5 text-sm font-medium text-heading">
        <%= pluralize(current_workspace.products.size + current_workspace.services.size, "item") %>
      </dd>
    </div>
    <div class="rounded-control border border-border bg-background px-4 py-3">
      <dt class="text-xs text-muted">Connected accounts</dt>
      <dd class="mt-0.5 text-sm font-medium text-heading">
        <%= current_workspace.social_accounts.connected.size %>
      </dd>
    </div>
    <div class="rounded-control border border-border bg-background px-4 py-3">
      <dt class="text-xs text-muted">Plan</dt>
      <dd class="mt-0.5 text-sm font-medium text-heading">
        <%= current_workspace.subscription&.plan&.name || "Not chosen yet" %>
      </dd>
    </div>
  </dl>
</div>
