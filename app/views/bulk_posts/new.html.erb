<% content_for :title, "Plan a month" %>
<% slug = { workspace_slug: current_workspace.slug } %>

<header class="mb-6">
  <%= link_to "← Create", workspace_create_path(**slug),
        class: "text-sm text-muted underline underline-offset-4 hover:text-heading" %>
  <h1 class="mt-3 font-display text-3xl font-normal sm:text-4xl">
    Plan a month<span aria-hidden="true" class="ml-1 align-super text-base text-warning">&#10022;</span>
  </h1>
  <p class="mt-1.5 max-w-prose text-sm text-muted">
    Pick the styles you want, choose what each one features, and Prachar spreads them across
    your posting days. Up to <%= Bulk::CreatePosts::MAX %> at a time.
  </p>
</header>

<%= render "shared/flash" %>

<%= form_with url: edit_workspace_bulk_post_path(**slug), method: :get,
              data: { controller: "bulk-select" } do %>

  <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
    <nav class="flex gap-2">
      <% [[ "Everything", nil ], [ "Photos", "image" ], [ "Videos", "video" ]].each do |label, value| %>
        <%= link_to label, new_workspace_bulk_post_path(**slug, format_filter: value),
              class: class_names(
                "flex h-9 items-center rounded-pill border px-3.5 text-sm font-medium",
                "border-primary bg-primary text-primary-contrast" => @format == value,
                "border-border bg-surface text-body hover:bg-surface-sunk" => @format != value) %>
      <% end %>
    </nav>

    <p class="text-sm text-muted">
      <span data-bulk-select-target="count">0</span> chosen
    </p>
  </div>

  <%#
    Video is offered because a month of content is not all photographs, but it
    is labelled: nothing here can generate video, so those posts get their slot
    and their caption and wait for the owner's own file (spec 30).
  %>
  <% if @format != "image" %>
    <p class="mb-5 flex gap-3 rounded-card border border-border bg-gold-tint px-5 py-4 text-sm text-body">
      <%= render "shared/note_icon", tone: "text-warning" %>
      <span>
        <span class="font-medium text-heading">Video styles are scheduled, not made.</span>
        Prachar cannot generate video yet, so a video post gets its slot and caption and waits
        for you to add your own file. Photo styles are made for you.
      </span>
    </p>
  <% end %>

  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    <% @templates.each do |template| %>
      <li>
        <label class="block cursor-pointer overflow-hidden rounded-card border-2 border-border bg-surface transition-shadow has-checked:border-primary has-checked:shadow-card">
          <%= check_box_tag "template_ids[]", template.id, false,
                id: "template_#{template.id}", class: "peer sr-only",
                data: { action: "bulk-select#toggle" } %>

          <span class="relative block aspect-4/5 bg-surface-sunk">
            <% if template.preview.attached? %>
              <%= image_tag template.preview.variant(resize_to_fill: [ 400, 500 ]), alt: "",
                    loading: "lazy", class: "h-full w-full object-cover" %>
            <% end %>

            <span aria-hidden="true"
                  class="absolute right-2.5 top-2.5 flex h-6 w-6 items-center justify-center rounded-full border-2 border-white bg-surface/80 text-xs font-semibold text-transparent peer-checked:bg-primary peer-checked:text-primary-contrast">
              &#10003;
            </span>

            <% if template.media_format == "video" %>
              <span class="absolute bottom-2.5 left-2.5 rounded-pill bg-heading/80 px-2 py-0.5 text-[11px] font-medium text-primary-contrast">
                Video
              </span>
            <% end %>
          </span>

          <span class="block px-3.5 py-3">
            <span class="block truncate text-sm font-medium text-heading"><%= template.name %></span>
            <span class="block text-xs text-muted"><%= template.content_category.to_s.humanize %></span>
          </span>
        </label>
      </li>
    <% end %>
  </ul>

  <%= render StickyActionFooterComponent.new do |footer| %>
    <% footer.with_note do %>
      <span data-bulk-select-target="summary">Nothing chosen yet</span>
    <% end %>
    <% footer.with_primary do %>
      <%= submit_tag "Choose what they feature",
            data: { bulk_select_target: "submit" },
            class: "h-11 cursor-pointer rounded-control bg-primary px-5 text-sm font-medium text-primary-contrast hover:bg-primary-hover disabled:opacity-50" %>
    <% end %>
  <% end %>
<% end %>
