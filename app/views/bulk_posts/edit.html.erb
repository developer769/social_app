<% content_for :title, "Choose what each one features" %>
<% slug = { workspace_slug: current_workspace.slug } %>
<% zone = current_workspace.timezone %>
<% catalog = @products.to_a + @services.to_a %>

<header class="mb-6">
  <%= link_to "← Change the styles", new_workspace_bulk_post_path(**slug),
        class: "text-sm text-muted underline underline-offset-4 hover:text-heading" %>
  <h1 class="mt-3 font-display text-3xl font-normal sm:text-4xl">
    Choose what each one features<span aria-hidden="true" class="ml-1 align-super text-base text-warning">&#10022;</span>
  </h1>
  <p class="mt-1.5 max-w-prose text-sm text-muted">
    <%= pluralize(@ordered.size, "style") %> chosen. Pick one thing from your catalog for each,
    then check the dates below.
  </p>
</header>

<%= render "shared/flash" %>

<% if catalog.empty? %>
  <%= render EmptyStateComponent.new(
        icon: :catalog,
        title: "Nothing in your catalog yet",
        body: "Add a product or service first, so each post has something to be about.") do |state| %>
    <% state.with_action do %>
      <%= link_to "Add a product", workspace_settings_catalog_path(**slug),
            class: "inline-flex h-11 items-center rounded-control bg-primary px-5 text-sm font-medium text-primary-contrast hover:bg-primary-hover" %>
    <% end %>
  <% end %>
<% else %>
  <%= form_with url: workspace_bulk_post_path(**slug), method: :post,
                data: { controller: "bulk-assign" },
                class: "grid gap-6 lg:grid-cols-[minmax(0,1fr)_21rem]" do %>

    <% @ordered.each { |template| %>
      <%= hidden_field_tag "template_ids[]", template.id %>
    <% } %>
    <%= hidden_field_tag :starting, @starting %>

    <div class="min-w-0 space-y-4">
      <div class="flex flex-wrap items-center gap-3 rounded-card border border-border bg-surface px-5 py-4">
        <label for="apply_all" class="text-sm font-medium text-heading">Use the same thing for all</label>
        <select id="apply_all" data-action="bulk-assign#applyAll"
                class="h-10 flex-1 rounded-control border border-border bg-background px-3 text-sm text-heading focus:border-border-strong focus:outline-none">
          <option value="">Choose one by one instead</option>
          <% catalog.each do |item| %>
            <option value="<%= item.class.name %>:<%= item.id %>"><%= item.name %></option>
          <% end %>
        </select>
      </div>

      <ul class="space-y-3">
        <% @ordered.each_with_index do |template, index| %>
          <li class="rounded-card border border-border bg-surface p-4">
            <div class="flex flex-wrap items-start gap-4">
              <% if template.preview.attached? %>
                <%= image_tag template.preview.variant(resize_to_fill: [ 160, 200 ]), alt: "",
                      loading: "lazy", class: "h-20 w-16 shrink-0 rounded-control object-cover" %>
              <% else %>
                <span aria-hidden="true" class="h-20 w-16 shrink-0 rounded-control bg-surface-sunk"></span>
              <% end %>

              <div class="min-w-0 flex-1">
                <p class="flex flex-wrap items-center gap-2 text-sm font-medium text-heading">
                  <%= template.name %>
                  <% if template.media_format == "video" %>
                    <%= render StatusBadgeComponent.new(label: "You add the video", tone: :warning) %>
                  <% end %>
                </p>

                <p class="mt-0.5 text-xs text-muted">
                  <% if (slot = @plan.slots[index]) %>
                    Goes out <%= slot.in_time_zone(zone).strftime("%a %-d %b at %-l:%M %p") %>
                  <% else %>
                    No free slot within the next few months &mdash; this one will not be scheduled
                  <% end %>
                </p>

                <label for="subject_<%= template.id %>" class="sr-only">
                  What <%= template.name %> should feature
                </label>
                <select name="subjects[<%= template.id %>]" id="subject_<%= template.id %>"
                        data-bulk-assign-target="subject"
                        class="mt-2.5 h-10 w-full rounded-control border border-border bg-background px-3 text-sm text-heading focus:border-border-strong focus:outline-none">
                  <option value="">Nothing in particular</option>
                  <% catalog.each do |item| %>
                    <option value="<%= item.class.name %>:<%= item.id %>"><%= item.name %></option>
                  <% end %>
                </select>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    </div>

    <aside class="space-y-5">
      <section class="rounded-card border border-border bg-surface p-5">
        <h2 class="font-display text-lg font-normal">When they go out</h2>

        <%#
          Said plainly. This is arithmetic over the days the owner chose, not a
          model deciding anything, and calling it clever would be a claim about
          something that does not exist (spec 22).
        %>
        <p class="mt-1.5 text-xs text-muted">
          Spread across your posting days at your usual time. Nothing lands on a slot that
          already has a post.
        </p>

        <div class="mt-4">
          <label for="starting" class="text-sm font-medium text-heading">Start from</label>
          <%= date_field_tag :starting, @starting, min: Date.current,
                data: { action: "bulk-assign#restart" },
                class: "mt-1.5 h-10 w-full rounded-control border border-border bg-background px-3 text-sm text-heading focus:border-border-strong focus:outline-none" %>
        </div>

        <dl class="mt-4 space-y-2 border-t border-border pt-4 text-sm">
          <div class="flex justify-between gap-3">
            <dt class="text-muted">Posts</dt>
            <dd class="tabular-nums text-heading"><%= @plan.count %></dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="text-muted">First</dt>
            <dd class="text-heading"><%= @plan.first_on&.strftime("%-d %b") || "—" %></dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="text-muted">Last</dt>
            <dd class="text-heading"><%= @plan.last_on&.strftime("%-d %b") || "—" %></dd>
          </div>
        </dl>

        <% if @plan.short? %>
          <p class="mt-3 rounded-control bg-warning-soft px-3.5 py-2.5 text-xs text-body">
            Only <%= @plan.count %> of <%= @ordered.size %> fit on your posting days.
            Add more days or post more often under
            <%= link_to "Posting preferences", workspace_settings_posting_preferences_path(**slug),
                  class: "underline underline-offset-4" %>.
          </p>
        <% end %>

        <p class="mt-3 text-xs text-muted">
          Each caption starts with the product's name. Prachar cannot write captions, so they
          are yours to edit &mdash; every post stays editable until it goes out.
        </p>
      </section>

      <%= submit_tag "Schedule #{pluralize(@plan.count, 'post')}",
            class: "h-11 w-full cursor-pointer rounded-control bg-primary px-5 text-sm font-medium text-primary-contrast hover:bg-primary-hover" %>

      <%= link_to "Cancel", workspace_create_path(**slug),
            class: "block text-center text-sm text-muted underline underline-offset-4 hover:text-heading" %>
    </aside>
  <% end %>
<% end %>
