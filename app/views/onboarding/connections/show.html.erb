<% content_for :title, "Social connections" %>

<%= render "onboarding/step_header",
      title: "Social Connections",
      subtitle: "Connect the accounts Prachar will publish to and read performance from." %>

<%= render "shared/flash" %>

<% if SocialProvider::Registry.any_real? == false %>
  <div role="note" class="mb-6 flex gap-3 rounded-card border border-border bg-blue-soft px-5 py-4">
    <span aria-hidden="true" class="text-primary">&#9432;</span>
    <p class="text-sm text-body">
      <span class="font-medium text-heading">These connections are simulated.</span>
      Real accounts need each platform's API credentials and app review, which are approved
      one provider at a time. Connecting here creates a placeholder account so you can see
      how the rest of Prachar behaves &mdash; nothing is published to a real profile.
    </p>
  </div>
<% end %>

<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem] xl:grid-cols-[minmax(0,1fr)_22rem]">
  <ul class="grid gap-4 sm:grid-cols-2">
    <% @providers.each do |provider| %>
      <li>
        <%= render "onboarding/connections/provider_card",
              provider: provider, account: @accounts_by_provider[provider.key] %>
      </li>
    <% end %>
  </ul>

  <%= render ContextualHelpPanelComponent.new(
        title: "What Prachar can do",
        summary: "Each platform allows different things through its API. Prachar only offers what a platform genuinely supports.",
        tone: :lavender) do |panel| %>
    <% panel.with_point(title: "Publishing",
          body: "YouTube and TikTok accept video only. Google Business Profile does not accept video at all.") %>
    <% panel.with_point(title: "Messages",
          body: "LinkedIn has no page-level direct messages, so no LinkedIn inbox will appear.") %>
    <% panel.with_point(title: "Limits",
          body: "X allows 280 characters; Instagram allows 2,200. Prachar checks each caption before scheduling.") %>
  <% end %>
</div>

<%= render StickyActionFooterComponent.new do |footer| %>
  <% footer.with_secondary do %>
    <%= link_to "Back", workspace_onboarding_catalog_path(workspace_slug: current_workspace.slug),
          class: "flex h-11 items-center rounded-control border border-border px-5 text-sm font-medium text-body hover:bg-surface-sunk" %>
  <% end %>
  <% footer.with_note do %>
    <%= pluralize(@accounts_by_provider.values.count { |a| a.connection_connected? }, "account") %> connected.
  <% end %>
  <% footer.with_primary do %>
    <%= button_to "Continue",
          workspace_onboarding_connections_complete_path(workspace_slug: current_workspace.slug),
          class: "h-11 cursor-pointer rounded-control bg-primary px-6 text-sm font-medium text-primary-contrast hover:bg-primary-hover" %>
  <% end %>
<% end %>
