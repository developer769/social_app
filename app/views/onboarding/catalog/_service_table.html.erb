<section class="rounded-card border border-border bg-surface p-6 sm:p-7">
  <h2 class="font-display text-xl font-normal">
    Your services <span class="text-base text-muted">(<%= services.size %>)</span>
  </h2>

  <% if services.empty? %>
    <%= render EmptyStateComponent.new(
        icon: :catalog,
        title: "No services yet",
          body: "Add your first service above. Prachar uses these to highlight what you offer in content and ads.") %>
  <% else %>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[46rem] border-collapse text-sm">
        <caption class="sr-only">Services in your catalog</caption>
        <thead>
          <tr class="border-b border-border text-left">
            <th scope="col" class="py-2.5 pr-4 text-xs font-semibold uppercase tracking-wide text-muted">Service</th>
            <th scope="col" class="py-2.5 pr-4 text-xs font-semibold uppercase tracking-wide text-muted">Category</th>
            <th scope="col" class="py-2.5 pr-4 text-xs font-semibold uppercase tracking-wide text-muted">Duration</th>
            <th scope="col" class="py-2.5 pr-4 text-xs font-semibold uppercase tracking-wide text-muted">Starting price</th>
            <th scope="col" class="py-2.5 pr-4 text-xs font-semibold uppercase tracking-wide text-muted">Taking bookings</th>
            <th scope="col" class="py-2.5 text-right text-xs font-semibold uppercase tracking-wide text-muted">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% services.each do |service| %>
            <tr class="border-b border-border last:border-0">
              <th scope="row" class="py-3 pr-4 text-left font-medium text-heading">
                <span class="flex items-center gap-3">
                  <%= render CatalogThumbComponent.new(item: service, size: :small) %>
                  <%= service.name %>
                </span>
              </th>
              <td class="py-3 pr-4">
                <% if service.category.present? %>
                  <span class="rounded-pill bg-gold-tint px-2.5 py-1 text-xs text-heading"><%= service.category %></span>
                <% end %>
              </td>
              <td class="py-3 pr-4 text-muted"><%= service.duration_label || "—" %></td>
              <td class="py-3 pr-4 tabular-nums text-heading">
                <% if service.starting_price %>
                  <%= MoneyPresenter.new(service.starting_price).full %>
                <% else %>
                  <span class="text-muted">&mdash;</span>
                <% end %>
              </td>
              <td class="py-3 pr-4">
                <%# The same one-tap control as products, over the state a
                    service actually changes: whether it is being taken on. %>
                <div class="flex gap-1" role="group"
                     aria-label="Availability for <%= service.name %>">
                  <% {
                       "available" => [ "On", :success ],
                       "coming_soon" => [ "Soon", :warning ],
                       "unavailable" => [ "Off", :danger ]
                     }.each do |status, (label, tone)| %>
                    <% current = service.availability_status == status %>
                    <%= button_to availability_workspace_service_path(
                          workspace_slug: current_workspace.slug, id: service),
                          method: :patch, params: { availability_status: status },
                          disabled: current,
                          class: class_names(
                            "cursor-pointer rounded-control border px-2 py-1 text-xs font-medium",
                            "border-#{tone} bg-#{tone}-soft text-#{tone}" => current,
                            "border-border text-muted hover:bg-surface-sunk" => !current) do %>
                      <%= label %><span class="sr-only"> availability for <%= service.name %></span>
                    <% end %>
                  <% end %>
                </div>
              </td>
              <td class="py-3">
                <div class="flex items-center justify-end gap-1">
                <%= link_to "Edit", edit_workspace_service_path(
                      workspace_slug: current_workspace.slug, id: service),
                      class: "rounded-control px-2 py-1 text-xs font-medium text-primary hover:bg-surface-sunk" %>

                <%= button_to workspace_service_path(workspace_slug: current_workspace.slug, id: service),
                      method: :delete,
                      form: { data: { turbo_confirm: "Delete #{service.name}? This cannot be undone." } },
                      class: "cursor-pointer rounded-control px-2 py-1 text-xs font-medium text-danger hover:bg-danger-soft" do %>
                  Delete<span class="sr-only"> <%= service.name %></span>
                <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
