<div>
  <span class="mb-1.5 block text-sm font-medium text-heading">
    Upload logo <span class="font-normal text-muted">(optional)</span>
  </span>

  <% if profile.logo.attached? %>
    <div class="flex items-center gap-4 rounded-control border border-border bg-background p-4">
      <%= image_tag profile.logo.variant(resize_to_limit: [96, 96]),
            alt: "Current logo for #{current_workspace.name}",
            class: "h-16 w-16 rounded-control object-contain" %>
      <div class="min-w-0 text-sm">
        <p class="font-medium text-heading">Logo uploaded</p>
        <p class="mt-0.5 text-xs text-muted">Choose a new file below to replace it.</p>
      </div>
    </div>
  <% end %>

  <label for="business_setup_logo"
         class="mt-3 flex cursor-pointer flex-col items-center justify-center rounded-control border border-dashed border-border-strong bg-background px-4 py-8 text-center hover:bg-surface-sunk">
    <span aria-hidden="true" class="mb-2 text-muted">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-7 w-7">
        <path d="M12 15V4m0 0L8.5 7.5M12 4l3.5 3.5" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" stroke-linecap="round" />
      </svg>
    </span>
    <span class="text-sm text-body">
      Drag &amp; drop your logo here or <span class="text-primary underline underline-offset-4">browse files</span>
    </span>
    <span class="mt-1 text-xs text-muted">PNG, JPG, SVG or WebP (max 2MB)</span>
    <%= file_field_tag "business_setup[logo]", id: "business_setup_logo",
          accept: BrandProfile::LOGO_CONTENT_TYPES.join(","), class: "sr-only" %>
  </label>
</div>
