<% content_for :title, "Sign in to Prachar" %>

<%#
  A frosted card on a pink-purple gradient with underline-only fields, centred
  on its own. Moving to sign-up turns the card over rather than replacing the
  page; see the auth-flip keyframes.
%>
<div class="auth-orchid">
  <%= render "shared/floating_platforms" %>

  <div class="orchid-layout">

    <div class="auth-enter orchid-card">
      <div class="mb-7 text-center">
        <%= render "shared/wordmark", classes: "text-lg" %>
        <h1 class="orchid-title mt-4">Log In</h1>
      </div>

      <%= render "shared/flash" %>

      <%= form_with url: login_path, method: :post, class: "space-y-6" do |form| %>
        <div class="orchid-row">
          <%# Visually hidden rather than absent: a placeholder disappears the
              moment somebody types, leaving a filled form with no way to tell
              what each line was for. %>
          <%= form.label :email, "Email address", class: "sr-only" %>
          <%= form.email_field :email, value: params[:email], required: true, autofocus: true,
                autocomplete: "email", placeholder: "Email", class: "orchid-field" %>
          <%= render "shared/orchid_icons", icon: :mail %>
        </div>

        <div class="orchid-row" data-controller="password-visibility">
          <%= form.label :password, "Password", class: "sr-only" %>
          <%= form.password_field :password, required: true, autocomplete: "current-password",
                placeholder: "Password", class: "orchid-field",
                data: { password_visibility_target: "field" } %>
          <%# The padlock reads as a show/hide control whether or not it is one,
              so it is one. Rendered decorative first and swapped for the button
              by the controller, so with no JavaScript the line looks exactly as
              it did rather than offering a button that cannot work. %>
          <span data-password-visibility-target="decor"><%= render "shared/orchid_icons", icon: :lock %></span>
          <button type="button" hidden
                  class="orchid-toggle"
                  data-password-visibility-target="button"
                  data-action="password-visibility#toggle"
                  aria-label="Show password">
            <span data-password-visibility-target="eye"><%= render "shared/orchid_icons", icon: :eye %></span>
            <span data-password-visibility-target="eyeOff" hidden><%= render "shared/orchid_icons", icon: :eye_off %></span>
          </button>
        </div>

        <%# Without this a forgotten password locked somebody out for good. %>
        <p class="pt-1 text-center text-sm">
          <%= link_to "Forgotten your password?", new_password_reset_path, class: "orchid-link" %>
        </p>

        <div class="pt-2">
          <%= form.submit "Log In", class: "orchid-button" %>
        </div>
      <% end %>

      <p class="mt-7 text-center text-sm">
        <%= link_to "Don't have an account?", signup_path, class: "orchid-link" %>
      </p>
    </div>

  </div>
</div>
