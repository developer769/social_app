<% content_for :title, "Sign in to Prachar" %>

<%#
  One centred column. The scene that used to fill a left-hand panel now runs
  behind the whole screen, so the animation is still there without cutting the
  page in two.

  It is decoration and nothing depends on it: the canvas is aria-hidden, carries
  no content, and the stage's gradient underneath is a finished screen on its
  own if WebGL never loads.
%>
<div class="auth-stage" data-controller="brand-scene">
  <canvas data-brand-scene-target="canvas" aria-hidden="true" class="auth-stage-canvas"></canvas>

  <div class="auth-stage-content">
    <div class="mb-7 text-center">
      <%= render "shared/wordmark", classes: "text-3xl", tone: :light %>
    </div>

    <div class="auth-enter auth-glass rounded-card border border-border bg-surface p-8 shadow-card sm:p-10">
      <div class="mb-8 text-center">
        <span aria-hidden="true"
              class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-blue-soft text-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-7 w-7">
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8" stroke-linecap="round" />
          </svg>
        </span>
        <h1 class="font-display text-3xl font-normal">Welcome back</h1>
        <p class="mt-2 text-sm text-muted">Log in to continue to your Prachar account</p>
      </div>

      <%= render "shared/flash" %>

      <%= form_with url: login_path, method: :post, class: "space-y-5" do |form| %>
        <div>
          <%= form.label :email, "Email address", class: "mb-1.5 block text-sm font-medium text-heading" %>
          <%= form.email_field :email, value: params[:email], required: true, autofocus: true,
                autocomplete: "email", placeholder: "you@yourbusiness.com",
                class: "h-11 w-full rounded-control border border-border bg-background px-3.5 text-sm text-heading placeholder:text-muted focus:border-border-strong focus:outline-none" %>
        </div>

        <div>
          <%= form.label :password, "Password", class: "mb-1.5 block text-sm font-medium text-heading" %>
          <%= form.password_field :password, required: true, autocomplete: "current-password",
                class: "h-11 w-full rounded-control border border-border bg-background px-3.5 text-sm text-heading focus:border-border-strong focus:outline-none" %>
        </div>

        <%# Without this a forgotten password locked somebody out for good. %>
        <p class="mb-4 text-sm">
          <%= link_to "Forgotten your password?", new_password_reset_path,
                class: "text-primary underline underline-offset-4" %>
        </p>

        <%= form.submit "Continue",
              class: "h-11 w-full cursor-pointer rounded-control bg-primary px-4 text-sm font-medium text-primary-contrast transition-colors hover:bg-primary-hover" %>
      <% end %>

      <div class="my-7 flex items-center gap-4" aria-hidden="true">
        <span class="h-px flex-1 bg-border"></span>
        <span class="text-xs text-muted">or</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>

      <p class="text-center text-sm text-muted">
        New to Prachar?
        <%= link_to "Create account", signup_path,
              class: "font-medium text-primary underline underline-offset-4 hover:text-primary-hover" %>
      </p>
    </div>
  </div>
</div>
