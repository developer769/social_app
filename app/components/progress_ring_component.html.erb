<div class="relative shrink-0" style="width: <%= size %>px; height: <%= size %>px;"
     role="img"
     aria-label="<%= aria_label %>">
  <svg viewBox="<%= view_box %>" class="h-full w-full -rotate-90" aria-hidden="true" focusable="false">
    <circle cx="<%= centre %>" cy="<%= centre %>" r="<%= ProgressRingComponent::RADIUS %>"
            fill="none" stroke="var(--color-border)" stroke-width="<%= ProgressRingComponent::STROKE %>" />
    <circle cx="<%= centre %>" cy="<%= centre %>" r="<%= ProgressRingComponent::RADIUS %>"
            fill="none" stroke="var(--color-primary)" stroke-width="<%= ProgressRingComponent::STROKE %>"
            stroke-linecap="round"
            stroke-dasharray="<%= circumference %>"
            stroke-dashoffset="<%= dash_offset %>" />
  </svg>

  <div class="absolute inset-0 flex flex-col items-center justify-center">
    <span class="font-display text-3xl leading-none text-heading tabular-nums"><%= percentage %><span class="text-lg">%</span></span>
    <% if caption.present? %>
      <span class="mt-1 text-xs text-muted"><%= caption %></span>
    <% end %>
  </div>
</div>
