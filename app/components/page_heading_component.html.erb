<header class="mb-7 flex flex-wrap items-start justify-between gap-4">
  <div class="min-w-0">
    <% if eyebrow? %>
      <div class="mb-1.5"><%= eyebrow %></div>
    <% end %>

    <%= content_tag("h#{level}", class: "font-display text-3xl font-normal sm:text-4xl") do %>
      <%= title %>
    <% end %>

    <% if subtitle.present? %>
      <p class="mt-1.5 max-w-prose text-sm text-muted"><%= subtitle %></p>
    <% end %>
  </div>

  <% if actions? %>
    <div class="flex shrink-0 flex-wrap items-center gap-2"><%= actions %></div>
  <% end %>
</header>
