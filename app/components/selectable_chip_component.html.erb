<label for="<%= input_id %>"
       class="group relative flex cursor-pointer items-start gap-2.5 rounded-control border px-3.5 py-2.5 text-sm transition-colors
              border-border bg-surface text-body hover:border-border-strong
              has-checked:border-primary has-checked:bg-gold-tint has-checked:text-heading
              has-disabled:cursor-not-allowed has-disabled:opacity-50">
  <input type="checkbox"
         id="<%= input_id %>"
         name="<%= name %>"
         value="<%= value %>"
         <%= "checked" if checked %>
         <%= "disabled" if disabled %>
         class="peer mt-0.5 h-4 w-4 shrink-0 accent-[var(--color-primary)]" />

  <span class="min-w-0">
    <span class="block font-medium"><%= label %></span>
    <% if description.present? %>
      <span class="mt-0.5 block text-xs text-muted"><%= description %></span>
    <% end %>
  </span>
</label>
