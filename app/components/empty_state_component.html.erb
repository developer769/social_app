<div class="mt-4 rounded-control border border-dashed border-border-strong bg-background px-6 py-10 text-center">
  <span aria-hidden="true" class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-surface-sunk text-muted">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-5 w-5">
      <rect x="4" y="5" width="16" height="14" rx="2" />
      <path d="M4 15l4-4 3 3 3-3 6 6" stroke-linejoin="round" />
    </svg>
  </span>

  <p class="font-medium text-heading"><%= title %></p>
  <% if body.present? %>
    <p class="mx-auto mt-1.5 max-w-sm text-sm text-muted"><%= body %></p>
  <% end %>
  <% if action? %>
    <div class="mt-5"><%= action %></div>
  <% end %>
</div>
