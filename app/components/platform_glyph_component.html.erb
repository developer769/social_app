<span class="inline-flex shrink-0 items-center justify-center rounded-full <%= size_classes %>"
      style="background-color: <%= tint %>; color: <%= colour %>;"
      title="<%= name %>">
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="h-[68%] w-[68%]">
    <%= raw path %>
  </svg>
  <span class="sr-only"><%= name %></span>
</span>
